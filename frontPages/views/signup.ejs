<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("Bases/CustomerHead", {title: "Sign up"}) %>
    <link rel="stylesheet" href="/css/shop-auth.css">
</head>
<body class="auth-body">
    <span class="cd-sprinkle cd-sprinkle--a" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--b" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--c" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--d" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--e" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--f" aria-hidden="true"></span>

    <main class="auth-card cd-card">
        <a href="/home" class="auth-card__logo" aria-label="Carwan Dough — home"><img src="/imgs/logo.PNG" alt="Carwan Dough" width="180" height="72"></a>
        <h1>Join the club</h1>
        <p class="auth-sub">Create an account to start ordering treats.</p>
        <form action="#" method="post">
            <label class="cd-field" for="signup-name">
                <span>Name</span>
                <input type="text" id="signup-name" name="username" placeholder="Name" required>
            </label>
            <label class="cd-field" for="signup-phone">
                <span>Phone</span>
                <input type="number" id="signup-phone" name="phone" placeholder="Phone" required>
            </label>
            <label class="cd-field" for="signup-password">
                <span>Password</span>
                <span class="password-wrap">
                    <input type="password" id="signup-password" name="password" placeholder="Password" required>
                    <i id="togglePasswordIcon" class="fa fa-eye-slash" role="button" tabindex="0" aria-label="Show password"></i>
                </span>
            </label>
            <label class="cd-field" for="signup-password-again">
                <span>Confirm password</span>
                <span class="password-wrap">
                    <input type="password" id="signup-password-again" name="passwordAgian" placeholder="Enter password again" required>
                    <i id="togglePasswordAgainIcon" class="fa fa-eye-slash" role="button" tabindex="0" aria-label="Show password"></i>
                </span>
            </label>
            <button type="submit" class="cd-btn auth-submit">Create account</button>
        </form>
        <div class="auth-links">
            <a href="/login">Already have an account? Log in</a>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const password = document.querySelector("[name='password']")
        const passwordAgain = document.querySelector("[name='passwordAgian']")
        const phoneNum = document.querySelector("[name='phone']")
        document.forms[0].onsubmit = function(event){
            samepass=false
            phone_num = false
            if(phoneNum.value.length == 11){
                phone_num = true
            }
            if(password.value === passwordAgain.value){
                samepass=true
            }
            if(samepass === false){
                if (phone_num === false){
                    Swal.fire({
                    icon: "error",
                    title: "Enter a valid phone number",
                    "confirmButtonColor": "#c01836",
                    });
                }
                else{
                    Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: "password not similar",
                    "confirmButtonColor": "#c01836",
                    });
                }
                event.preventDefault()
            }
        }
        const togglePasswordIcon = document.querySelector("#togglePasswordIcon");
        const togglePasswordAgainIcon = document.querySelector("#togglePasswordAgainIcon");

        // Toggle password visibility
        togglePasswordIcon.addEventListener("click", function () {
            const type = password.type === "password" ? "text" : "password";
            password.type = type;
            this.classList.toggle("fa-eye"); // Assuming you are using FontAwesome for the icon
            this.classList.toggle("fa-eye-slash");
        });

        togglePasswordAgainIcon.addEventListener("click", function () {
            const type = passwordAgain.type === "password" ? "text" : "password";
            passwordAgain.type = type;
            this.classList.toggle("fa-eye");
            this.classList.toggle("fa-eye-slash");
        });

        [togglePasswordIcon, togglePasswordAgainIcon].forEach((icon) => {
            icon.addEventListener("keydown", function (e) {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    this.click();
                }
            });
        });
//   //|-------------------------------------------------------------------|
//   //|__________________________   Send Data  ___________________________|
//   //|-------------------------------------------------------------------|

    const signupForm = document.querySelector("form")

    signupForm.addEventListener("submit", (e) => {
        e.preventDefault()
        if(samepass){
        const fd = new FormData(signupForm)
        const urlEncodedData = new URLSearchParams(fd).toString();
        fetch("/api/auth/register",{
        body:urlEncodedData,
        method:"POST",
        headers:{
            "Content-Type": "application/x-www-form-urlencoded",
        }
        }).then(response=>{
        if(response.ok){
            Swal.fire({
            "icon":"success",
            "title":"Welcome to Carwan Dough",
            "confirmButtonColor": "#c01836",
            });
            setTimeout(()=>{
                window.location.href = "/"
            },1500)
        }else{
            return response.json().then(errMsg => {
                Swal.fire({
                icon: "error",
                title: errMsg.msg ,
                "confirmButtonColor": "#c01836",
                });
            });
            }
        })
    }
    });

</script>
</body>
</html>
