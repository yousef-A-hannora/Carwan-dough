<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="shortcut icon" href="/imgs/mini-logo.png" type="image/x-icon">

    <title>Signup</title>
</head>
<body>
    <div class="logo-container">
        <a href="/home"><img src="/imgs/logo.PNG" class="logo"></a>
    </div>
    <div class="login-container">
        <h2>Signup</h2>
        <form action="#" method="post">
            <input type="text" name="username" placeholder="Name" required>
            <input type="number" name="phone" placeholder="Phone" required >
            <input type="text" name="email" placeholder="email" required >
            <div style="display: flex;gap: 5px;align-items: center;width: 106%;">
                <input type="password" name="password" placeholder="password" required>
                <i id="togglePasswordIcon" class="fa fa-eye-slash" style="cursor: pointer;font-size: 1.5em;"></i>
            </div>
            <div style="display: flex;gap: 5px;align-items: center;width: 106%;">
                <input type="password" name="passwordAgian" placeholder="Enter password again" required>
                <i id="togglePasswordAgainIcon" class="fa fa-eye-slash" style="cursor: pointer;font-size: 1.5em;"></i>
            </div>
            <button type="submit">Create account</button>
        </form>
        <div class="forgot-password">
            <a href="/login">Or Login</a>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const password = document.querySelector("[name='password']")
        const passwordAgain = document.querySelector("[name='passwordAgian']")
        const phoneNum = document.querySelector("[name='phone']")
        document.forms[0].onsubmit = function(event){
            samepass=false
            phone_num = false
            if(phoneNum.value.length == 11){
                phone_num = true
            }
            if(password.value === passwordAgain.value){
                samepass=true
            }
            if(samepass === false){
                if (phone_num === false){
                    Swal.fire({
                    icon: "error",
                    title: "Enter a valid phone number",
                    "confirmButtonColor": "#c01836",
                    });
                }
                else{
                    Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: "password not similar",
                    "confirmButtonColor": "#c01836",
                    });
                }
                event.preventDefault()
            }
        }
        const togglePasswordIcon = document.querySelector("#togglePasswordIcon");
        const togglePasswordAgainIcon = document.querySelector("#togglePasswordAgainIcon");

        // Toggle password visibility
        togglePasswordIcon.addEventListener("click", function () {
            const type = password.type === "password" ? "text" : "password";
            password.type = type;
            this.classList.toggle("fa-eye"); // Assuming you are using FontAwesome for the icon
            this.classList.toggle("fa-eye-slash");
        });

        togglePasswordAgainIcon.addEventListener("click", function () {
            const type = passwordAgain.type === "password" ? "text" : "password";
            passwordAgain.type = type;
            this.classList.toggle("fa-eye");
            this.classList.toggle("fa-eye-slash");
        });
//   //|-------------------------------------------------------------------|
//   //|__________________________   Send Data  ___________________________|
//   //|-------------------------------------------------------------------|

    const signupForm = document.querySelector("form")

    signupForm.addEventListener("submit", (e) => {
        e.preventDefault()
        if(samepass){
        const fd = new FormData(signupForm)
        const urlEncodedData = new URLSearchParams(fd).toString();
        fetch("/api/auth/register",{
        body:urlEncodedData,
        method:"POST",
        headers:{
            "Content-Type": "application/x-www-form-urlencoded",
        }
        }).then(response=>{
        if(response.ok){
            Swal.fire({
            "icon":"success",
            "title":"We have sent a code to your email",
            "confirmButtonColor": "#c01836",
            });
            setTimeout(()=>{
                window.location.href = "/OTP"
            },3000)
        }else{
            return response.json().then(errMsg => {
                Swal.fire({
                icon: "error",
                title: errMsg.msg ,
                "confirmButtonColor": "#c01836",
                });
            });
            }
        })
    }
    });
    
</script>
</body>
</html>