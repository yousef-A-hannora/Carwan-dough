<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <!----======== CSS ======== -->
    <link rel="stylesheet" href="/css/admin.css">

    <!----===== Iconscout CSS ===== -->
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <title>Statistics — Carwan Dough Admin</title>
</head>
<body>
<%- include("Bases/adminBase") %>
            <div class="overview">
                <div class="title">
                    <i class="uil uil-chart"></i>
                    <div>
                        <span class="text">Statistics</span>
                        <div class="page-sub">Store performance and customer insights</div>
                    </div>
                </div>
            </div>

            <main>

                <form method="GET" action="" class="date-range-form">
                    <div class="field">
                        <label for="from">From</label>
                        <input type="date" name="from" id="from">
                    </div>
                    <div class="field">
                        <label for="to">To</label>
                        <input type="date" name="to" id="to">
                    </div>
                    <button class="btn btn-primary">Apply</button>
                </form>

                <div class="stat-grid">
                    <div class="stat-card">
                        <span class="stat-icon icon-brand"><i class="uil uil-truck"></i></span>
                        <div class="stat-body">
                            <span class="stat-label">Total Orders</span>
                            <span class="stat-value"><%= done+canceled %></span>
                            <span class="stat-sub"><span class="up"><%= done %> done</span> &middot; <span class="down"><%= canceled %> canceled</span></span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <span class="stat-icon icon-success"><i class="uil uil-usd-circle"></i></span>
                        <div class="stat-body">
                            <span class="stat-label">Total Earnings</span>
                            <span class="stat-value"><%= earning %></span>
                            <span class="stat-sub">EGP</span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <span class="stat-icon icon-info"><i class="uil uil-users-alt"></i></span>
                        <div class="stat-body">
                            <span class="stat-label">Customers</span>
                            <span class="stat-value"><%= users.length %></span>
                            <span class="stat-sub">in selected period</span>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-head">
                        <span class="card-title"><i class="uil uil-users-alt"></i>Customers</span>
                        <span class="badge badge-neutral">Flagged rows highlighted in red</span>
                    </div>
                    <div class="table-scroll" style="max-height: 420px; overflow-y: auto;">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Address</th>
                                    <th>Completed Orders</th>
                                    <th>Total Pay</th>
                                    <th>Canceled Orders</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(Array.isArray(users)){ %>
                                <% for(let user of users){ %>
                                <tr class="<% if(user.redFlags > 0){ %> red-flag <% } %>">
                                    <td class="cell-strong"><%= user.name %></td>
                                    <td class="cell-muted"><%= user.phone %></td>
                                    <td class="cell-muted"><%= user.address %></td>
                                    <td><%= user.done %></td>
                                    <td class="cell-price"><%= user.total %></td>
                                    <td><%= user.canceled %></td>
                                    <td><button userId="<%= user.id %>" class="btn btn-sm btn-outline unflage">Unflag</button></td>
                                </tr>
                                <% } %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card">
                    <div class="card-head">
                        <span class="card-title"><i class="uil uil-chart-bar"></i>Products Sold</span>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="donutSalesChart"></canvas>
                        </div>
                    </div>
                </div>
            </main>
<%- include("Bases/adminBaseCloser") %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
document.addEventListener("click", (e) => {
    if (e.target.classList.contains("unflage")) {
        const button = e.target;
        const userId = button.getAttribute("userId");

        // Make the fetch request
        fetch("/api/user/operations/unflage", {
            method: "PATCH",
            body: JSON.stringify({ id: userId }),
            headers: {
                "Content-Type": "application/json",
            },
        })
            .then((response) => {
                if (response.ok) {
                    // If the request is successful, find the parent <tr> and remove the class
                    const tr = button.closest("tr"); // Get the closest parent <tr> of the button
                    // console.log(tr)
                    if (tr.classList.contains("red-flag")) {
                        // console.log("this tr contains red-flag")
                        tr.classList.remove("red-flag");
                    }
                } else {
                    console.error("Failed to unflag the user.");
                }
            })
            .catch((err) => {
                console.error("Error:", err);
            });
    }
});
    </script>
    <script>
        // Sample data for donuts sold by type
        const Products = '<%= products %>'; // Safely embed Base64 string
        const donutSalesData = JSON.parse(atob(Products)); // Decode and parse


        // console.log(donutSalesData["chocolate"])
        const donutTypes = Object.keys(donutSalesData)
        const donutsSold = Object.values(donutSalesData)

        const ctx = document.getElementById('donutSalesChart').getContext('2d');
        const donutSalesChart = new Chart(ctx, {
    type: 'bar',
    data: {
    labels: donutTypes,
    datasets: [{
    label: 'Sold',
    data: donutsSold,
    backgroundColor: 'rgba(192, 24, 54, 0.7)', // Primary color
    borderColor: '#c01836',
    borderWidth: 1
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
        tooltip: {
        enabled: true,
        callbacks: {
            label: function(context) {
            return ` ${context.dataset.label}: ${context.parsed.y}`;
            }
        }
        },
        datalabels: {
        anchor: 'end',
        align: 'top',
        color: '#000',
        font: {
            weight: 'bold'
        },
        formatter: function(value) {
            return value; // Shows the value directly on each bar
        }
        }
    },
    scales: {
        x: {
        beginAtZero: true,
        title: {
            display: true,
            text: 'Donut Type'
        }
        },
        y: {
        beginAtZero: true,
        title: {
            display: true,
            text: 'Number of Donuts Sold'
        }
        }
    }
    },
});
</script>
</body>
</html>
