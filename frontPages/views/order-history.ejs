<!DOCTYPE html>
<!--=== Coding by CodingLab | www.codinglabweb.com === -->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <!----======== CSS ======== -->
     <link rel="stylesheet" href="/css/style.css">
     <link rel="stylesheet" href="/css/orders.css">
     <link rel="stylesheet" href="/css/analytics.css">
    <!----===== Iconscout CSS ===== -->
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">

    <title>Orders history</title> 
</head>
<body>
<%- include("Bases/adminBase") %>

            <div class="overview">
                <div class="title">
                    <i class="uil uil-history"></i>
                    <span class="text">Orders History</span>
                </div>
            </div>
            <main>
                <form action="" class="date-range-form">
                    <div>
                        <label>From</label>
                        <input type="date" name="from" id="from">
                    </div>
                    <div>
                        <label>To</label>
                        <input type="date" name="to" id="to">
                    </div>
                    <button class="open-modal-btn">Find</button>
                </form>
                <!-- Order Details Table -->
<!-- Order Details Table -->
<table class="order-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>delivery Date</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Order Details</th>
            <th>notes</th>
            <th>Payment State</th>
        </tr>
    </thead>
    <tbody>
        <!-- Sample Row -->
        <% for(let order of orders){ %>
            <tr orderId="<%= order.id %>" class="tableContent <% if(order.orderStatus === "CANCELED"){ %> red-flag <% } %>">

            <td class="idField"><%= order.id %></td>
            <td class="dateField"><%= String(order.deliveryDate).split(" ").slice(1,3)%></td>
            <td class="nameField"><%= order.OrderRecevername %></td>
            <td class="phoneField">
                <% for(let phone of order.orderPhones){ %>
                    <li><%= phone.number %></li>
                <% } %>
            </td>
            <td class="addressField"><%= order.address %></td>
            <td class="itemsField">
                <ul style="padding-left: 20px;">
                    <% for(let item of order.orderItems){ %>
                        <% if(item.notes){ %>
                            <li>
                                <%= item.product.name %>:
                                <ul style="padding-left: 20px; list-style-type: square;">
                                    <% for(let prod of Object.keys(item.notes) ){ %>
                                        <li><%= prod %>: <%= item.notes[prod]*4 %></li>
                                    <% } %>
                                </ul>
                            </li>
                        <% }else{ %>
                            <li><%= item.product.name %>: <%= item.quantity %></li>
                        <% } %>
                    <% } %>
                </ul>
                <hr style="border-top: 1px dashed red; margin: 10px 0;">
                <li style="list-style: none;">Total => <%= order.totalPrice %> Egp</li>
            </td>
            <td class="paymethodField"><%= order.OrderNotes %></td>
            <% if(order.paymentType === "CASH_ON_DELIVERY" ){ %>
                <td class="paymethodField">On Delivery</td>
            <% }else{ %>
                <td class="paymethodField">Prepaid</td>
            <% } %>

        </tr>
        <% } %>
    </tbody>
</table>

            </main>
<%- include("Bases/adminBaseCloser") %>

    <script>
        
        function changeTableRows(filteredOrdersIds){
            const tableRows = Array.from(document.getElementsByClassName("tableContent"));
            tableRows.forEach(row=>{
                let orderId = parseInt(row.getAttribute("orderId"))
                if(!filteredOrdersIds.includes(orderId)){
                    
                    row.style.display = "none"
                }else{
                    row.style.display = "table-row"
                }
            })
        }

        const donutSummaryList = document.getElementById("donutSummaryList");
        const summaryItemsEncoded = '<%= ordersForFilter %>'; // Safely embed Base64 string
        const orders = JSON.parse(atob(summaryItemsEncoded)); // Decode and parse
        

        const filterDateFrom = document.getElementById("from");
        const filterDateTo = document.getElementById("to");

        document.querySelector("form").addEventListener("submit",(e)=>{
            e.preventDefault();
            // console.log("date form submitted")
            const filteredOrders = [];
            const filteredOrdersIds = [];
            let startDate = new Date(filterDateFrom.value);
            let endDate = new Date(filterDateTo.value);
            
            orders.forEach((order=>{
                let orderDeliveryDate = new Date(order.deliveryDate)
                
                if(orderDeliveryDate >= startDate && orderDeliveryDate <= endDate){
                    filteredOrdersIds.push(order.id);
                }
            }));
            changeTableRows(filteredOrdersIds)
        })

    </script>
</body>
</html>