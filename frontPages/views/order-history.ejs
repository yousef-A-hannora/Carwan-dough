<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <!----======== CSS ======== -->
    <link rel="stylesheet" href="/css/admin.css">
    <!----===== Iconscout CSS ===== -->
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">

    <title>Order History — Carwan Dough Admin</title>
</head>
<body>
<%- include("Bases/adminBase") %>

            <div class="overview">
                <div class="title">
                    <i class="uil uil-history"></i>
                    <div>
                        <span class="text">Order History</span>
                        <div class="page-sub">Completed and rejected orders</div>
                    </div>
                </div>
            </div>
            <main>
                <form action="" class="date-range-form">
                    <div class="field">
                        <label for="from">From</label>
                        <input type="date" name="from" id="from">
                    </div>
                    <div class="field">
                        <label for="to">To</label>
                        <input type="date" name="to" id="to">
                    </div>
                    <button class="btn btn-primary">Find</button>
                </form>

                <div class="card">
                    <div class="card-head">
                        <span class="card-title"><i class="uil uil-history"></i>Past Orders</span>
                        <span class="badge badge-brand"><%= orders.length %> order<% if(orders.length !== 1){ %>s<% } %></span>
                    </div>
                    <div class="table-scroll">
                        <table class="order-table data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Delivery Date</th>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Address</th>
                                    <th>Order Details</th>
                                    <th>Notes</th>
                                    <th>Payment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(orders.length === 0){ %>
                                <tr>
                                    <td colspan="8">
                                        <div class="empty-state">
                                            <i class="uil uil-history"></i>
                                            No orders found in history yet.
                                        </div>
                                    </td>
                                </tr>
                                <% } %>
                                <% for(let order of orders){ %>
                                    <tr orderId="<%= order.id %>" class="tableContent <% if(order.orderStatus === "CANCELED"){ %> red-flag <% } %>">

                                    <td class="idField"><%= order.id %></td>
                                    <td class="dateField"><%= String(order.deliveryDate).split(" ").slice(1,3)%></td>
                                    <td class="nameField"><%= order.OrderRecevername %></td>
                                    <td class="phoneField">
                                        <% for(let phone of order.orderPhones){ %>
                                            <li><%= phone.number %></li>
                                        <% } %>
                                    </td>
                                    <td class="addressField"><%= order.address %></td>
                                    <td class="itemsField">
                                        <ul class="items-list">
                                            <% for(let item of order.orderItems){ %>
                                                <% if(item.notes){ %>
                                                    <li>
                                                        <%= item.product.name %>:
                                                        <% if(item.product.category && item.product.category["name"]==='share boxs'){ %>
                                                        <ul class="sub-list">
                                                            <% for(let prod of Object.keys(item.notes) ){ %>
                                                                <li><%= prod %>: <%= item.notes[prod]*4 %></li>
                                                            <% } %>
                                                        </ul>
                                                        <% }else if(item.product.category && item.product.category["name"]==='custom orders'){ %>
                                                            <ul class="sub-list">
                                                                <li><%= item.notes["details"] %></li>
                                                            </ul>
                                                        <% }else{ %>
                                                            <ul class="sub-list">
                                                                <% for(let prod of Object.keys(item.notes) ){ %>
                                                                    <li><%= prod %>: <%= item.notes[prod] %></li>
                                                                <% } %>
                                                            </ul>
                                                        <% } %>
                                                    </li>
                                                <% }else{ %>
                                                    <li><%= item.product.name %>: <%= item.quantity %></li>
                                                <% } %>
                                            <% } %>
                                        </ul>
                                        <div class="order-total-line">Total &mdash; <%= order.totalPrice %> EGP</div>
                                    </td>
                                    <td class="notesField"><%= order.OrderNotes %></td>
                                    <% if(order.paymentType === "CASH_ON_DELIVERY" ){ %>
                                        <td class="paymethodField"><span class="badge badge-warning"><i class="uil uil-bill"></i>On Delivery</span></td>
                                    <% }else{ %>
                                        <td class="paymethodField"><span class="badge badge-success"><i class="uil uil-check-circle"></i>Prepaid</span></td>
                                    <% } %>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
<%- include("Bases/adminBaseCloser") %>

    <script>

        function changeTableRows(filteredOrdersIds){
            const tableRows = Array.from(document.getElementsByClassName("tableContent"));
            tableRows.forEach(row=>{
                let orderId = parseInt(row.getAttribute("orderId"))
                if(!filteredOrdersIds.includes(orderId)){

                    row.style.display = "none"
                }else{
                    row.style.display = "table-row"
                }
            })
        }

        const summaryItemsEncoded = '<%= ordersForFilter %>'; // Safely embed Base64 string
        const orders = JSON.parse(atob(summaryItemsEncoded)); // Decode and parse


        const filterDateFrom = document.getElementById("from");
        const filterDateTo = document.getElementById("to");

        document.querySelector("form").addEventListener("submit",(e)=>{
            e.preventDefault();
            // console.log("date form submitted")
            const filteredOrders = [];
            const filteredOrdersIds = [];
            let startDate = new Date(filterDateFrom.value);
            let endDate = new Date(filterDateTo.value);

            orders.forEach((order=>{
                let orderDeliveryDate = new Date(order.deliveryDate)

                if(orderDeliveryDate >= startDate && orderDeliveryDate <= endDate){
                    filteredOrdersIds.push(order.id);
                }
            }));
            changeTableRows(filteredOrdersIds)
        })

    </script>
</body>
</html>
