<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("Bases/CustomerHead") %>
    <link rel="stylesheet" href="/css/shop-home.css">
</head>
<body>
    <%- include("Bases/CustomerHeader") %>

    <section class="hero">
        <div class="cd-container hero__inner">
            <div class="hero__copy">
                <span class="hero__eyebrow"><i class="fa-solid fa-cookie-bite" aria-hidden="true"></i>Donuts &amp; sweet treats</span>
                <h1 class="hero__title">Sugar, spice &amp; everything nice</h1>
                <p class="hero__sub">Handcrafted donuts, candy and custom sweet boxes — pick your favourites and get them delivered on your day.</p>
                <div class="hero__actions">
                    <a href="#menu" class="cd-btn">Browse the menu</a>
                    <a href="https://wa.me/+201556364646" class="cd-btn-secondary"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i>Order on WhatsApp</a>
                </div>
            </div>
            <div class="hero__art" aria-hidden="true">
                <div class="hero__blob"></div>
                <span class="cd-sprinkle cd-sprinkle--1"></span>
                <span class="cd-sprinkle cd-sprinkle--2"></span>
                <span class="cd-sprinkle cd-sprinkle--3"></span>
                <span class="cd-sprinkle cd-sprinkle--4"></span>
                <span class="cd-sprinkle cd-sprinkle--5"></span>
                <span class="cd-sprinkle cd-sprinkle--6"></span>
                <img src="/imgs/cake1.png" alt="" class="hero__img hero__img--1 cd-float" width="300" height="300">
                <img src="/imgs/cina3.png" alt="" class="hero__img hero__img--2 cd-float" width="260" height="260">
                <img src="/imgs/doug8.png" alt="" class="hero__img hero__img--3 cd-float" width="240" height="240">
            </div>
        </div>
        <svg class="cd-wave" viewBox="0 0 1440 56" preserveAspectRatio="none" aria-hidden="true" style="color: var(--cd-red);">
            <path fill="currentColor" d="M0,56 L0,28 C160,50 320,6 480,14 C640,22 720,52 880,44 C1040,36 1140,8 1280,14 C1360,17 1400,28 1440,32 L1440,56 Z"></path>
        </svg>
    </section>

    <div class="ribbon">
        <div class="cd-container">
            <ul class="ribbon__list">
                <li><i class="fa-solid fa-box-open" aria-hidden="true"></i>Custom boxes</li>
                <li><i class="fa-solid fa-gift" aria-hidden="true"></i>Share boxes</li>
                <li><i class="fa-solid fa-calendar-day" aria-hidden="true"></i>Pick your delivery day</li>
                <li><i class="fa-solid fa-money-bill-wave" aria-hidden="true"></i>Pay on delivery</li>
            </ul>
        </div>
    </div>

    <section class="section" id="menu">
        <div class="cd-container">
            <h2 class="section__title cd-reveal">Our Menu</h2>
            <p class="section__sub cd-reveal" style="--i:1;">Pick a category and fill your box with treats.</p>
            <div class="menu-grid">
                <% let cardIndex = 0; %>
                <% for(let cat of CWP){ %>
                    <% if(cat.isActive){ %>
                    <% const activeProducts = cat.products.filter(p => p.isActive && !p.deleted); %>
                    <a href="/CategoryProducts/<%= cat.id %>" class="cat-card cd-card cd-reveal" style="--i:<%= cardIndex % 4 + 1 %>;">
                        <div class="cat-card__media slider" data-slider-id="<%= cat.id %>">
                            <img src="/products/images/<%= cat.image %>" class="slide-<%= cat.id %> is-active" alt="<%= cat.name %>" loading="lazy">
                            <% for(let product of activeProducts){ %>
                                <img src="/products/images/<%= product.photo %>" class="slide-<%= cat.id %>" alt="<%= cat.name %> — <%= product.name %>" loading="lazy">
                            <% } %>
                        </div>
                        <div class="cat-card__body">
                            <h3 class="cat-card__name"><%= cat.name %></h3>
                            <p class="cat-card__count"><%= activeProducts.length %> <%= activeProducts.length === 1 ? "treat" : "treats" %></p>
                            <span class="cat-card__cta">Explore <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                        </div>
                    </a>
                    <% cardIndex++; %>
                    <% } %>
                <% } %>
            </div>
        </div>
    </section>

    <section class="section section--alt">
        <div class="cd-container">
            <h2 class="section__title cd-reveal">How it works</h2>
            <p class="section__sub cd-reveal" style="--i:1;">Three little steps between you and a box of joy.</p>
            <div class="steps">
                <div class="step cd-card cd-reveal" style="--i:1;">
                    <span class="step__num">1</span>
                    <h3>Pick your treats</h3>
                    <p>Browse the menu and add your favourite donuts and candies to the cart.</p>
                </div>
                <div class="step cd-card cd-reveal" style="--i:2;">
                    <span class="step__num">2</span>
                    <h3>Choose your delivery day</h3>
                    <p>Tell us where and which day you want your order delivered.</p>
                </div>
                <div class="step cd-card cd-reveal" style="--i:3;">
                    <span class="step__num">3</span>
                    <h3>Pay on delivery</h3>
                    <p>Sit back — pay when your sweets arrive at your door.</p>
                </div>
            </div>
        </div>
    </section>

    <% const boxCat = (CWP || []).find(c => c.isActive && (c.name === "share boxs" || c.name === "custom orders")); %>
    <% if(boxCat){ %>
    <section class="section">
        <div class="cd-container">
            <div class="band band--pink cd-reveal">
                <span class="cd-sprinkle cd-sprinkle--a"></span>
                <span class="cd-sprinkle cd-sprinkle--b"></span>
                <span class="cd-sprinkle cd-sprinkle--c"></span>
                <span class="cd-sprinkle cd-sprinkle--d"></span>
                <span class="cd-sprinkle cd-sprinkle--e"></span>
                <h2 class="band__title">Build your own box</h2>
                <p>Mix and match your favourite treats into one sweet box — perfect for sharing (or not).</p>
                <a href="/CategoryProducts/<%= boxCat.id %>" class="cd-btn">Start building</a>
            </div>
        </div>
    </section>
    <% } %>

    <section class="section" style="padding-top: 0;">
        <div class="cd-container">
            <div class="band band--red cd-reveal">
                <h2 class="band__title">Craving something sweet?</h2>
                <p>Message us on WhatsApp and we'll help you put together the perfect order.</p>
                <a href="https://wa.me/+201556364646" class="cd-btn-secondary"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i>Chat on WhatsApp</a>
            </div>
        </div>
    </section>

    <%- include("Bases/CustomerFooter") %>

    <script>
        localStorage.clear()
    </script>
</body>
</html>
