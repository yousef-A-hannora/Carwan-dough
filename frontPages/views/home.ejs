    <script>
        localStorage.clear()

        const sliders = document.querySelectorAll('.slider');
        const slideIndices = {};
    
        sliders.forEach(slider => {
            const sliderId = slider.getAttribute('data-slider-id');
            slideIndices[sliderId] = 0; // Initialize the slide index for each slider
            const slides = slider.querySelectorAll(`.slide-${sliderId}`);
    
            function showSlide() {
                // Hide all slides in the current slider
                slides.forEach(slide => (slide.style.display = 'none'));
    
                // Increment the slide index, wrap around if necessary
                slideIndices[sliderId] = (slideIndices[sliderId] + 1) % slides.length;
    
                // Show the current slide
                slides[slideIndices[sliderId]].style.display = 'block';
    
                // Continue the slideshow for the current slider
                setTimeout(showSlide, 1000);
            }
    
            // Start the slideshow for this slider
            showSlide();
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const logoutLink = document.getElementById("logout-link");
    
            if (logoutLink) {
                logoutLink.addEventListener("click", (event) => {
                    event.preventDefault(); // Prevent the default navigation
    
                    Swal.fire({
                        title: 'really want to logout',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: 'green',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, logout!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = logoutLink.href; // Redirect if confirmed
                        }
                    });
                });
            }
        });
    </script>
