<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("Bases/CustomerHead", {title: product.name}) %>
    <link rel="stylesheet" href="/css/shop-product.css">
</head>
<body>
<%- include("Bases/CustomerHeader") %>

    <nav class="cd-container cd-breadcrumb" aria-label="Breadcrumb">
        <a href="/home">Home</a>
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        <a href="/CategoryProducts/<%= product.categoryId %>"><%= product.category.name %></a>
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        <span aria-current="page"><%= product.name %></span>
    </nav>

    <main class="cd-container product-layout">
        <div class="media-card cd-card">
        <% if(product.video){ %>
                <video autoplay muted loop controls playsinline>
                    <source src="/products/videos/<%= product.video %>" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            <% }else{ %>
                    <img src="/products/images/<%= product.photo %>" alt="<%= product.name %>" width="600" height="600">
            <% } %>
        </div>
        <% if(product.category.name==="share boxs"){ %>
            <%- include("OddComponents/ShareBoxForm") %>
        <% }else if(product.category.name==="custom orders"){ %>
            <%- include("OddComponents/customProductForm") %>
        <% }else{ %>

            <div class="info-container">
                <a href="/CategoryProducts/<%= product.categoryId %>" class="cd-chip"><i class="fa-solid fa-tag" aria-hidden="true"></i><%= product.category.name %></a>
                <h1 class="product-title"><%= product.name %></h1>
                <p class="description"><%= product.description %></p>

                <div class="price-block">
                    <span class="price-block__label">Price</span>
                    <% if(product.current_price !== product.price){ %>
                        <s><span id="product-price"><%= product.price %> EGP</span></s>
                        <span id="product-price" class="price-block__current"><%= product.current_price %> EGP</span>
                        <span class="cd-badge-sale">Sale</span>
                    <% }else{ %>
                        <span id="product-price" class="price-block__current"><%= product.price %> EGP</span>
                    <% } %>
                </div>

                <div class="cart-controls">
                    <span class="cart-pill"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>In your cart: <span class="cart-quantity" id="quantity">1</span></span>
                </div>

                <form action="" class="styled-form">
                    <div class="qty-field">
                        <button type="button" class="qty-step" data-step="-1" aria-label="Decrease quantity">−</button>
                        <input type="number" name="quantity" placeholder="0" id="add-quantity" min="0" value="1">
                        <button type="button" class="qty-step" data-step="1" aria-label="Increase quantity">+</button>
                    </div>
                    <button type="submit" class="cd-btn"><i class="fa-solid fa-cart-plus" aria-hidden="true"></i>Add to cart</button>
                </form>
            </div>
        <% } %>
    </main>

<%- include("Bases/CustomerFooter") %>

<script>
    document.querySelectorAll(".qty-step").forEach((btn) => {
        btn.addEventListener("click", () => {
            const input = document.getElementById("add-quantity");
            if (!input) return;
            const step = parseInt(btn.getAttribute("data-step"));
            const next = (parseInt(input.value) || 0) + step;
            input.value = Math.max(parseInt(input.min) || 0, next);
        });
    });
</script>
<script>

    let quantity = document.getElementById("quantity");
    const addQuantityForm = document.querySelector("form");

    if(quantity && addQuantityForm && addQuantityForm.classList.contains("styled-form")){

    if(!localStorage[`product<%= product.id %>`]){localStorage[`product<%= product.id %>`] = 0}

    quantity.innerText = localStorage[`product<%= product.id %>`]

    addQuantityForm.addEventListener("submit", (e) => {
        let addQuantity = document.getElementById("add-quantity");

        e.preventDefault();
        const fd = new FormData(addQuantityForm);
        const UrlEncodedData = new URLSearchParams(fd).toString();

        fetch("/api/user/order/addToCart/<%= product.id %>",{
            body:UrlEncodedData,
            method:"PATCH",
            headers:{
                "Content-Type": "application/x-www-form-urlencoded",
            }
        }).then(responce=>{
            if(responce.ok){
                // console.log("request looks good")
                let currentElementCount = parseInt(localStorage[`product<%= product.id %>`]);
                // console.log(`currentElementCount = ${currentElementCount}`)
                localStorage[`product<%= product.id %>`] = currentElementCount + parseInt(addQuantity.value);
                // console.log(`currentElementCount + parseInt(addQuantity) : ${currentElementCount} + ${parseInt(addQuantity.value)} = ${currentElementCount + parseInt(addQuantity.value)}`)
                // console.log(`localStorage[product] = ${localStorage[`product<%= product.id %>`]} `)
                quantity.innerText = localStorage[`product<%= product.id %>`];

                Swal.fire({
                    icon: "success",
                    title: "Added to cart successfully",
                    "confirmButtonColor": "#c01836",
                });
                addQuantityForm.reset()

                setTimeout(()=>{
                    window.location.href = "/CategoryProducts/<%= product.categoryId %>";
                },1000)
            }
        })
    })
    }
</script>

</body>
</html>
