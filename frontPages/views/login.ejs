<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("Bases/CustomerHead", {title: "Log in"}) %>
    <link rel="stylesheet" href="/css/shop-auth.css">
</head>
<body class="auth-body">
    <span class="cd-sprinkle cd-sprinkle--a" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--b" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--c" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--d" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--e" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--f" aria-hidden="true"></span>

    <main class="auth-card cd-card">
        <a href="/home" class="auth-card__logo" aria-label="Carwan Dough — home"><img src="/imgs/logo.PNG" alt="Carwan Dough" width="180" height="72"></a>
        <h1>Welcome back</h1>
        <p class="auth-sub">Log in to order your favourite treats.</p>
        <form action="/login" method="post">
            <label class="cd-field" for="login-phone">
                <span>Phone</span>
                <input type="number" id="login-phone" placeholder="Phone" name="phone" required>
            </label>
            <label class="cd-field" for="login-password">
                <span>Password</span>
                <span class="password-wrap">
                    <input type="password" id="login-password" name="password" placeholder="Password" required>
                    <i id="togglePasswordIcon" class="fa fa-eye-slash" role="button" tabindex="0" aria-label="Show password"></i>
                </span>
            </label>
            <button type="submit" class="cd-btn auth-submit">Log in</button>
        </form>
        <div class="auth-links">
            <a href="/forgetPass">Forgot password?</a>
            <a href="/signup">New here? Create an account</a>
        </div>
    </main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const loginForm = document.querySelector("form")
    loginForm.addEventListener("submit", (e) => {
        e.preventDefault()
        const fd = new FormData(loginForm)

        const urlEncodedData = new URLSearchParams(fd).toString();
        fetch("/api/auth/login",{
        body:urlEncodedData,
        method:"POST",
        headers:{
            "Content-Type": "application/x-www-form-urlencoded",
        }
        }).then(response=>{
        if(response.ok){
            Swal.fire({
            "icon":"success",
            "title":"Welcome back",
            "confirmButtonColor": "#c01836",
            });
            setTimeout(()=>{
                window.location.href = "/"
            },1500)
            }else{
            return response.text().then(errMsg => {
                Swal.fire({
                icon: "error",
                title: "Wronge username or password" ,
                "confirmButtonColor": "#c01836",
                });
            });
            }
        })

    });

    const togglePasswordIcon = document.querySelector("#togglePasswordIcon");
    const password = document.querySelector("[name='password']")

        // Toggle password visibility
    togglePasswordIcon.addEventListener("click", function () {
        const type = password.type === "password" ? "text" : "password";
        password.type = type;
        this.classList.toggle("fa-eye"); // Assuming you are using FontAwesome for the icon
        this.classList.toggle("fa-eye-slash");
        this.setAttribute("aria-label", type === "password" ? "Show password" : "Hide password");
    });
    togglePasswordIcon.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            this.click();
        }
    });

</script>
</body>
</html>
