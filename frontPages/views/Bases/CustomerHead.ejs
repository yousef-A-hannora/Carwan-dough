<link rel="stylesheet" href="/css/shop.css">
<script>
/* scroll-reveal is progressive enhancement: hidden state is scoped to
   <html class="js">; the failsafe below reveals everything if shop.js
   never runs (blocked/404) so no content can stay invisible */
document.documentElement.classList.add("js");
addEventListener("load", function () {
    setTimeout(function () {
        if (!window.__cdReveal) {
            document.querySelectorAll(".cd-reveal").forEach(function (el) {
                el.classList.add("is-visible");
            });
        }
    }, 1500);
});
</script>
