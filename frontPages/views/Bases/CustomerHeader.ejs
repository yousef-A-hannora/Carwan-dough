<header class="cd-header" id="cd-header">
    <nav class="cd-container cd-nav" aria-label="Main navigation">
        <a href="/home" class="cd-logo-link" aria-label="Carwan Dough — home">
            <img src="/imgs/logo.PNG" class="cd-logo" alt="Carwan Dough" width="120" height="46">
        </a>
        <div class="cd-nav-links">
            <a href="/home#menu" class="cd-nav-link cd-nav-menu">Menu</a>
            <% if(!locals.isAuth){ %>
                <a href="/login" class="cd-btn cd-btn-sm">Log in</a>
            <% }else{ %>
                <span class="cd-nav-greet">Hi, <%= locals.username %></span>
                <a href="/api/auth/logout" id="logout-link" class="cd-icon-link" aria-label="Log out">
                    <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                </a>
            <% } %>
            <a href="/cart" class="cd-icon-link" aria-label="Cart">
                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                <span class="cd-icon-label">Cart</span>
            </a>
        </div>
    </nav>
</header>
