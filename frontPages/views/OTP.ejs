<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("Bases/CustomerHead", {title: "Verify"}) %>
    <link rel="stylesheet" href="/css/shop-auth.css">
</head>
<body class="auth-body">
    <span class="cd-sprinkle cd-sprinkle--a" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--b" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--c" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--d" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--e" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--f" aria-hidden="true"></span>

    <main class="auth-card cd-card">
        <a href="/home" class="auth-card__logo" aria-label="Carwan Dough — home"><img src="/imgs/logo.PNG" alt="Carwan Dough" width="180" height="72"></a>
        <h1>Check your WhatsApp</h1>
        <p class="auth-sub">We sent you a code — enter it below to verify your account.</p>
        <form action="/login" method="post">
            <label class="cd-field" for="otp-code">
                <span>Verification code</span>
                <input type="number" id="otp-code" placeholder="Code" name="OTP" required>
            </label>
            <button type="submit" class="cd-btn auth-submit">Verify</button>
        </form>
    </main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const loginForm = document.querySelector("form")
    loginForm.addEventListener("submit", (e) => {
        e.preventDefault()
        const fd = new FormData(loginForm)

        const urlEncodedData = new URLSearchParams(fd).toString();
        fetch("/api/auth/OTP",{
        body:urlEncodedData,
        method:"POST",
        headers:{
            "Content-Type": "application/x-www-form-urlencoded",
        }
        }).then(response=>{
        if(response.ok){
            Swal.fire({
            "icon":"success",
            "title":"Welcome",
            "confirmButtonColor": "#c01836",
            });
            setTimeout(()=>{
                window.location.href = "/"
            },1500)
            }else{
            return response.text().then(errMsg => {
                Swal.fire({
                icon: "error",
                title: "Wrong code, try again" ,
                "confirmButtonColor": "#c01836",
                });
            });
            }
        })

    });
</script>
</body>
</html>
