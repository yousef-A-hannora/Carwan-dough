<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("Bases/CustomerHead", {title: "Reset password"}) %>
    <link rel="stylesheet" href="/css/shop-auth.css">
</head>
<body class="auth-body">
    <span class="cd-sprinkle cd-sprinkle--a" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--b" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--c" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--d" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--e" aria-hidden="true"></span>
    <span class="cd-sprinkle cd-sprinkle--f" aria-hidden="true"></span>

    <main class="auth-card cd-card">
        <a href="/home" class="auth-card__logo" aria-label="Carwan Dough — home"><img src="/imgs/logo.PNG" alt="Carwan Dough" width="180" height="72"></a>
        <h1>Reset password</h1>
        <p class="auth-sub">Enter your phone number and we'll send a code to your WhatsApp.</p>
        <form action="/login" method="post">
            <label class="cd-field" for="reset-phone">
                <span>Phone</span>
                <input type="number" id="reset-phone" placeholder="Write your phone" name="phone" required>
            </label>
            <button type="submit" class="cd-btn auth-submit">Send code</button>
        </form>
        <div class="auth-links">
            <a href="/login">Back to log in</a>
        </div>
    </main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const loginForm = document.querySelector("form")
    loginForm.addEventListener("submit", (e) => {
        e.preventDefault()
        const fd = new FormData(loginForm)

        const urlEncodedData = new URLSearchParams(fd).toString();
        fetch("/api/auth/forgetPass",{
        body:urlEncodedData,
        method:"POST",
        headers:{
            "Content-Type": "application/x-www-form-urlencoded",
        }
        }).then(response=>{
        if(response.ok){
            Swal.fire({
            "icon":"success",
            "title":"Code sent to your whatapp",
            "confirmButtonColor": "#c01836",
            });
            setTimeout(()=>{
                window.location.href = "/OTP-pass"
            },1500)
            }else{
            return response.json().then(errMsg => {
                Swal.fire({
                icon: "error",
                title: errMsg.msg ,
                "confirmButtonColor": "#c01836",
                });
            });
            }
        })
    });
</script>
</body>
</html>
