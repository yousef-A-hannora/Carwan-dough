<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <title>Login</title>
</head>
<body>
    <div class="logo-container">
        <a href="/home"><img src="/imgs/logo.PNG" class="logo"></a>
    </div>
    <div class="login-container">
        <h2>Admin Login</h2>
        <form action="/login" method="post">
            <input type="text" placeholder="username" name="username" required>
            <div style="display: flex;gap: 5px;align-items: center;width: 106%;">
                <input type="password" name="password" placeholder="password" required>
                <i id="togglePasswordIcon" class="fa fa-eye-slash" style="cursor: pointer;font-size: 1.5em;"></i>
            </div>
            <button type="submit">Login</button>
        </form>
    </div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const loginForm = document.querySelector("form")
    loginForm.addEventListener("submit", (e) => {
        e.preventDefault()
        const fd = new FormData(loginForm)

        const urlEncodedData = new URLSearchParams(fd).toString();
        fetch("/api/auth/adminLogin",{
        body:urlEncodedData,
        method:"POST",
        headers:{
            "Content-Type": "application/x-www-form-urlencoded",
        }
        }).then(response=>{
        if(response.ok){
            Swal.fire({
            "icon":"success",
            "title":"Welcome back",
            "confirmButtonColor": "#c01836",
            });
            setTimeout(()=>{
                window.location.href = "/content"
            },1500)
            }else{
            return response.text().then(errMsg => {
                Swal.fire({
                icon: "error",
                title: "Wronge username or password" ,
                "confirmButtonColor": "#c01836",
                });
            });
            }
        })

    });

    const togglePasswordIcon = document.querySelector("#togglePasswordIcon");
    const password = document.querySelector("[name='password']")

        // Toggle password visibility
    togglePasswordIcon.addEventListener("click", function () {
        const type = password.type === "password" ? "text" : "password";
        password.type = type;
        this.classList.toggle("fa-eye"); // Assuming you are using FontAwesome for the icon
        this.classList.toggle("fa-eye-slash");
    });
</script>
</body>
</html>