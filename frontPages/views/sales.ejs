<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <!----======== CSS ======== -->
     <link rel="stylesheet" href="/css/admin.css">

    <!----===== Iconscout CSS ===== -->
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">

    <title>Sales — Carwan Dough Admin</title>
</head>
<body>
<%- include("Bases/adminBase") %>

            <div class="overview">
                <div class="title">
                    <i class="uil uil-pricetag-alt"></i>
                    <div>
                        <span class="text">Sales &amp; Coupons</span>
                        <div class="page-sub">Create and manage product discounts</div>
                    </div>
                </div>
            </div>
            <main>

                <div class="toolbar">
                    <button class="btn btn-primary" id="openSalesModal"><i class="uil uil-percentage"></i>Create Sale</button>
                </div>

                <div class="card">
                    <div class="card-head">
                        <span class="card-title"><i class="uil uil-pricetag-alt"></i>Active Sales</span>
                        <span class="badge badge-brand"><%= sales.length %> active</span>
                    </div>
                    <div class="table-scroll">
                        <table class="product-table data-table">
                            <thead>
                                <tr>
                                    <th>Discount</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Sale Items</th>
                                    <th class="col-actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(sales.length === 0){ %>
                                <tr>
                                    <td colspan="5">
                                        <div class="empty-state">
                                            <i class="uil uil-pricetag-alt"></i>
                                            No active sales right now.
                                        </div>
                                    </td>
                                </tr>
                                <% } %>
                                <% for(let sale of sales){ %>
                                <tr>
                                    <td><span class="badge badge-danger"><%= sale.salesPrecentage %>% OFF</span></td>
                                    <td class="cell-muted"><%= String(sale.startDate).split(" ").slice(1,3) %></td>
                                    <td class="cell-muted"><%= String(sale.endDate).split(" ").slice(1,3) %></td>
                                    <td>
                                        <ul class="items-list">
                                            <% for(let item of sale.products){ %>
                                                <li><%= item.name %></li>
                                            <% } %>
                                        </ul>
                                    </td>
                                    <td>
                                        <a href="#"><button class="remove-button" Sale-id="<%= sale.id %>">Remove</button></a>
                                    </td>
                                </tr>
                            <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>

<!-- Modal -->
<div id="AddSaleModal" class="modal">
    <div class="modal-content">
        <span class="close-button" id="closeSalesModal">&times;</span>
        <h2>Create Sale</h2>
        <form id="sales-form" >

            <div class="input-group">
                <label for="sale-percentage">Sale Percentage (%)</label>
                <input type="number" id="sale-percentage" name="salePercentage" required min="1" max="100">
            </div>

            <div class="input-group">
                <label for="start-date">Start Date</label>
                <input type="date" id="start-date" name="startDate" required>
            </div>

            <div class="input-group">
                <label for="end-date">End Date</label>
                <input type="date" id="end-date" name="endDate" required>
            </div>

            <div class="input-group">
                <label>Products on sale</label>
                <button type="button" id="select-all" class="btn btn-sm btn-outline" style="justify-self:start">Select All</button>
                <div class="check-list" id="product-list">
                    <% for(let product of products){ %>
                        <div class="input-work-dayes">
                            <label for="<%= product.name %>"><%= product.name %></label>
                            <input type="checkbox" name="products" value="<%= product.id %>" id="<%= product.name %>">
                        </div>
                    <% } %>
                </div>
            </div>
            <button class="submit-button">Add Sale</button>
        </form>
    </div>
</div>

<%- include("Bases/adminBaseCloser") %>

<script>
    // Ensure the modals are hidden initially
document.getElementById("AddSaleModal").style.display = "none";


// Open Add Product Modal when button is clicked
document.getElementById("openSalesModal").onclick = function() {
document.getElementById("AddSaleModal").style.display = "block";
};

// Close Add Product Modal
document.getElementById("closeSalesModal").onclick = function() {
document.getElementById("AddSaleModal").style.display = "none";
};


// Close modals if clicked outside the modal
window.onclick = function(event) {
if (event.target == document.getElementById("AddSaleModal")) {
    document.getElementById("AddSaleModal").style.display = "none";
}

};
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.getElementById('select-all').addEventListener('click', () => {
        document.querySelectorAll('#product-list input[type="checkbox"]').forEach(checkbox => {
            checkbox.checked = true;
        });
    });

    document.getElementById('sales-form').addEventListener('submit', (event) => {
        event.preventDefault();

        const formData = new FormData(event.target);
        const saleDetails = {
            salePercentage: formData.get('salePercentage'),
            startDate: formData.get('startDate'),
            endDate: formData.get('endDate'),
            products: formData.getAll('products'),
        };

        fetch('/api/admin/sales/addSale', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(saleDetails),
        }).then(response => {
                if(response.ok){
                    Swal.fire({
                        "icon":"success",
                        "title":"Sale created successfully",
                        "confirmButtonColor": "#c01836",
                    });
                    setTimeout(()=>{window.location.href="/sales"},1000)
                }
            })
        .catch(error => console.error('Error:', error));
    });
</script>
<script>
    document.addEventListener("click",e=>{
        if(e.target.classList.contains("remove-button")){
            saleId = e.target.getAttribute("Sale-id")
            fetch(`/api/admin/sales/deleteSale/${saleId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            })
            .then(response => {
                if(response.ok){
                    Swal.fire({
                        "icon":"success",
                        "title":"Sale removed successfully",
                        "confirmButtonColor": "#c01836",
                    });
                    setTimeout(()=>{window.location.href="/sales"},1000)
                }
            })
            .catch(error => console.error('Error:', error));
        }
    })
</script>
</body>
</html>
