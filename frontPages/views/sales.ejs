<!DOCTYPE html>
<!--=== Coding by CodingLab | www.codinglabweb.com === -->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <!----======== CSS ======== -->
     <link rel="stylesheet" href="/css/style.css">
     <link rel="stylesheet" href="/css/content.css">

    <!----===== Iconscout CSS ===== -->
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">

    <title>Sales and copons</title> 
</head>
<body>
<%- include("Bases/adminBase") %>

            <div class="overview">
                <div class="title">
                    <i class="uil-file-contract-dollar"></i>
                    <span class="text">Sales and copons</span>
                </div>
            </div>
            <main>
<body>
<!-- Modal -->
<button class="button" id="openSalesModal">Create Sale</button>

<div id="AddSaleModal" class="modal formInputs">
    <div class="modal-content">
        <span class="close-button" id="closeSalesModal">&times;</span>
        <h2>Add Sale</h2>
        <form id="sales-form" >

            <div class="input-group">
                <label for="sale-percentage">Sale Percentage (%):</label>
                <input type="number" id="sale-percentage" name="salePercentage" required>
            </div>

            <div class="input-group">
                <label for="start-date">Start Date:</label>
                <input type="date" id="start-date" name="startDate" required>
            </div>

            <div class="input-group">
                <label for="end-date">End Date:</label>
                <input type="date" id="end-date" name="endDate" required>
            </div>
            <br>            
            <br>            
            <button type="button" id="select-all" style="border: none;background-color: var(--red);color: var(--white);padding: 10px;border-radius: 20px;">Select All</button>
        <div style="height: 10em ;overflow: auto;display: flex;flex-direction: column;width: 100%;" id="product-list">
            
            <% for(let product of products){ %>
                <div class="input-work-dayes">
                    <label for="<%= product.name %>"><%= product.name %></label>
                    <input type="checkbox" name="products" value="<%= product.id %>" id="<%= product.name %>">
                </div>
            <% } %>
        </div>
        <br>
        <button class="submit-button">Add Sale</button>
    </form>
    </div>
</div>



<!-- Active Sales Table -->
<h1 class="category-name">Active Sales</h1>
<table class="product-table">
    <thead>
        <tr>
            <th>Sale percentage</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Sale Items</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% for(let sale of sales){ %>
        <tr>
            <td style="width: 0px;"><%= sale.salesPrecentage %>%</td>
            <td><%= String(sale.startDate).split(" ").slice(1,3) %></td>
            <td><%= String(sale.endDate).split(" ").slice(1,3) %></td>
            <td>
                <ul>
                    <% for(let item of sale.products){ %>
                        <li><%= item.name %></li>
                    <% } %>
                </ul>
            </td>
            <td style="width: 5vh;">
                <a href="#"><button class="remove-button" Sale-id="<%= sale.id %>" id="removeProd">Remove</button></a>
            </td>
        </tr>
    <% } %>
    </tbody>
</table>

            </main>
<%- include("Bases/adminBaseCloser") %>

</body>

<script>
    // Ensure the modals are hidden initially
document.getElementById("AddSaleModal").style.display = "none";


// Open Add Product Modal when button is clicked
document.getElementById("openSalesModal").onclick = function() {
document.getElementById("AddSaleModal").style.display = "block";
};

// Close Add Product Modal
document.getElementById("closeSalesModal").onclick = function() {
document.getElementById("AddSaleModal").style.display = "none";
};


// Close modals if clicked outside the modal
window.onclick = function(event) {
if (event.target == document.getElementById("AddSaleModal")) {
    document.getElementById("AddSaleModal").style.display = "none";
}

};
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.getElementById('select-all').addEventListener('click', () => {
        document.querySelectorAll('#product-list input[type="checkbox"]').forEach(checkbox => {
            checkbox.checked = true;
        });
    });

    document.getElementById('sales-form').addEventListener('submit', (event) => {
        event.preventDefault();

        const formData = new FormData(event.target);
        const saleDetails = {
            salePercentage: formData.get('salePercentage'),
            startDate: formData.get('startDate'),
            endDate: formData.get('endDate'),
            products: formData.getAll('products'),
        };

        fetch('/api/admin/sales/addSale', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(saleDetails),
        }).then(response => {
                if(response.ok){
                    Swal.fire({
                        "icon":"success",
                        "title":"Sale created successfully",
                        "confirmButtonColor": "#c01836",
                    });
                    setTimeout(()=>{window.location.href="/sales"},1000)
                }
            })
        .catch(error => console.error('Error:', error));
    });
</script>
<script>
    document.addEventListener("click",e=>{
        if(e.target.classList.contains("remove-button")){
            saleId = e.target.getAttribute("Sale-id")
            fetch(`/api/admin/sales/deleteSale/${saleId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            })
            .then(response => {
                if(response.ok){
                    Swal.fire({
                        "icon":"success",
                        "title":"Sale removed successfully",
                        "confirmButtonColor": "#c01836",
                    });
                    setTimeout(()=>{window.location.href="/sales"},1000)
                }
            })
            .catch(error => console.error('Error:', error));
        }
    })
</script>
</html>