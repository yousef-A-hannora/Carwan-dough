<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <!----======== CSS ======== -->
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/print.css">
    <!----===== Iconscout CSS ===== -->
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">

    <title>Orders — Carwan Dough Admin</title>
</head>
<body>
<%- include("Bases/adminBase") %>

            <div class="overview">
                <div class="title">
                    <i class="uil uil-clipboard-notes"></i>
                    <div>
                        <span class="text">Orders</span>
                        <div class="page-sub">Pending delivery orders</div>
                    </div>
                </div>
            </div>
            <main>
                <form action="" class="date-range-form">
                    <div class="field">
                        <label for="date">Filter by delivery date</label>
                        <input type="date" name="date" id="date"/>
                    </div>
                    <button class="btn btn-primary">Find</button>
                </form>

                <div class="toolbar actions">
                    <button class="btn btn-outline open-modal-btn" onclick="openModal()"><i class="uil uil-list-ul"></i>Order Summary</button>
                    <a href="/order-history" class="btn btn-ghost"><i class="uil uil-history"></i>Order History</a>
                    <div class="spacer"></div>
                    <button class="btn btn-outline open-modal-btn" onclick="printOrders()"><i class="uil uil-print"></i>Print Orders</button>
                </div>

                <!-- Modal for donut order summary -->
                <div id="orderSummaryModal" class="modal">
                    <div class="modal-content">
                        <span class="close" onclick="closeModal()">&times;</span>
                        <h3>Order Summary</h3>
                        <ul id="donutSummaryList"></ul>
                    </div>
                </div>

                <!-- Order Details Table -->
                <div class="card">
                    <div class="card-head">
                        <span class="card-title"><i class="uil uil-clipboard-notes"></i>Pending Orders</span>
                        <span class="badge badge-brand"><%= orders.length %> order<% if(orders.length !== 1){ %>s<% } %></span>
                    </div>
                    <div class="table-scroll">
                        <table class="order-table data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Delivery Date</th>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Address</th>
                                    <th>Order Details</th>
                                    <th>Payment</th>
                                    <th>Notes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(orders.length === 0){ %>
                                <tr>
                                    <td colspan="9">
                                        <div class="empty-state">
                                            <i class="uil uil-check-circle"></i>
                                            All caught up — no pending orders.
                                        </div>
                                    </td>
                                </tr>
                                <% } %>
                                <% for(let order of orders){ %>
                                <tr orderId="<%= order.id %>" class="tableContent <% if(order.user.redFlags > 0 && order.paymentStatus !== "PAID"){ %> red-flag <% }else if(order.paymentStatus === "PAID"){ %> payed <% } %>">

                                    <td class="idField"><%= order.id %></td>
                                    <td class="dateField"><%= String(order.deliveryDate).split(" ").slice(1,3)%></td>
                                    <td class="nameField"><%= order.OrderRecevername %></td>
                                    <td class="phoneField">
                                        <% for(let phone of order.orderPhones){ %>
                                            <li><%= phone.number %></li>
                                        <% } %>
                                    </td>
                                    <td class="addressField"><%= order.address %></td>
                                    <td class="itemsField">
                                        <ul class="items-list">
                                            <% for(let item of order.orderItems){ %>
                                                <% if(item.notes){ %>
                                                    <li>
                                                        <%= item.product.name %>:
                                                        <% if(item.product.category && item.product.category["name"]==='share boxs'){ %>
                                                        <ul class="sub-list">
                                                            <% for(let prod of Object.keys(item.notes) ){ %>
                                                                <li class="deails"><%= prod %>: <%= item.notes[prod]*4 %></li>
                                                            <% } %>
                                                        </ul>
                                                        <% }else if(item.product.category && item.product.category["name"]==='custom orders'){ %>
                                                            <ul class="sub-list">
                                                                <li class="deails"><%= item.notes["details"] %></li>
                                                            </ul>
                                                        <% }else{ %>
                                                            <ul class="sub-list">
                                                                <% for(let prod of Object.keys(item.notes) ){ %>
                                                                    <li class="deails"><%= prod %>: <%= item.notes[prod] %></li>
                                                                <% } %>
                                                            </ul>
                                                        <% } %>
                                                    </li>
                                                <% }else{ %>
                                                    <li><%= item.product.name %>: <%= item.quantity %></li>
                                                <% } %>
                                            <% } %>
                                        </ul>
                                        <div class="order-total-line">Total &mdash; <%= order.totalPrice %> EGP</div>
                                    </td>
                                    <% if(order.paymentStatus === "PAID"){ %>
                                        <td class="paymethodField"><span class="badge badge-success"><i class="uil uil-check-circle"></i>Prepaid</span></td>
                                    <% }else{ %>
                                        <td class="paymethodField"><span class="badge badge-warning"><i class="uil uil-bill"></i>Cash on delivery</span></td>
                                    <% } %>
                                    <td class="notesField"><%= order.OrderNotes %></td>
                                    <td>
                                        <div class="action-td">
                                            <button class="done-btn done" orderId="<%= order.id %>">Done</button>
                                            <button class="done-btn payed" orderId="<%= order.id %>">Mark Paid</button>
                                            <button class="done-btn canceled" orderId="<%= order.id %>">Reject</button>
                                        </div>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
<%- include("Bases/adminBaseCloser") %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        function makeSummaryHtml(itemsUniqueList){
            const container = document.getElementById("donutSummaryList");
            container.innerHTML = ""
            Object.keys(itemsUniqueList).forEach((item=>{
                let summaryItem = document.createElement("li");
                summaryItem.innerText = `${item}: ${itemsUniqueList[item]}`;
                container.appendChild(summaryItem);
            }))
        }

        function makeSammaryList(orders){
            const itemsUniqueList = {}
            // console.log(orders);
            orders.forEach(order => {
                order.orderItems.forEach((item)=>{
                    if(item.product.category["name"]==='share boxs'){
                        // For share boxes, only count the items inside, not the box itself
                        if(item.notes && typeof item.notes === 'object'){
                            Object.keys(item.notes).forEach(prod=>{
                                if(itemsUniqueList[`mini ${prod}`]){
                                    itemsUniqueList[`mini ${prod}`] += item.notes[prod]*4;
                                }else{
                                    itemsUniqueList[`mini ${prod}`] = item.notes[prod]*4;
                                }
                            })
                        }
                    } else {
                        // For regular products, count the product itself
                        if(itemsUniqueList[`${item.product.name}`]){
                            itemsUniqueList[`${item.product.name}`] += item.quantity;
                        }else{
                            itemsUniqueList[`${item.product.name}`] = item.quantity;
                        }
                    }
                })
            });
            makeSummaryHtml(itemsUniqueList)
        }

        function changeTableRows(filteredOrdersIds){
            const tableRows = Array.from(document.getElementsByClassName("tableContent"));
            tableRows.forEach(row=>{
                let orderId = parseInt(row.getAttribute("orderId"))
                if(!filteredOrdersIds.includes(orderId)){

                    row.style.display = "none"
                }else{
                    row.style.display = "table-row"
                }
            })
        }

        function removeOrder(orderId){
            const tableRows = Array.from(document.getElementsByClassName("tableContent"));
            const targetIndex = tableRows.findIndex(row=>{
                return row.getAttribute("orderId") == orderId;
            })
            tableRows[targetIndex].remove()
        }

        const donutSummaryList = document.getElementById("donutSummaryList");


        const summaryItemsEncoded = '<%= summaryItems %>';
        const orders = JSON.parse(atob(summaryItemsEncoded)); // Decode and parse

        const filterDate = document.getElementById("date");

        document.querySelector("form").addEventListener("submit",(e)=>{
            e.preventDefault();
            const filteredOrders = [];
            const filteredOrdersIds = [];
            if (!filterDate.value) {
                // If no date selected, show all orders
                makeSammaryList(orders);
                changeTableRows(orders.map(o => o.id));
                return;
            }
            let selectedDate = new Date(filterDate.value);
            // Normalize to local date (remove time component)
            const selectedDateStr = selectedDate.toISOString().split("T")[0];

            orders.forEach((order=>{
                if (!order.deliveryDate) return;
                // Handle both Date objects and date strings
                let orderDateStr;
                if (order.deliveryDate instanceof Date) {
                    orderDateStr = order.deliveryDate.toISOString().split("T")[0];
                } else {
                    // Handle string dates
                    orderDateStr = String(order.deliveryDate).split("T")[0];
                }
                if(orderDateStr === selectedDateStr){
                    filteredOrders.push(order);
                    filteredOrdersIds.push(order.id);
                }
            }));
            makeSammaryList(filteredOrders);
            changeTableRows(filteredOrdersIds)
        })


        makeSammaryList(orders);

        // Open Modal
        function openModal() {
            document.getElementById("orderSummaryModal").style.display = "block";
            // loadDonutSummary();  // Function to load donut type and quantity
        }

        // Close Modal
        function closeModal() {
            document.getElementById("orderSummaryModal").style.display = "none";
        }

        // Close the summary modal when clicking the backdrop
        document.getElementById("orderSummaryModal").addEventListener("click", (e) => {
            if (e.target.id === "orderSummaryModal") closeModal();
        });

    document.addEventListener("click", (e) => {
        // console.log("click")
    if (e.target.classList.contains("done")) {
        // console.log("done")
        const orderId = e.target.getAttribute("orderId");

        Swal.fire({
            title: "sure to mark this as done?",
            icon: "question",
            color:"#53ae8c",
            showCancelButton: true,
            confirmButtonText: "Yes, mark as done",
            cancelButtonText: "Cancel",
            confirmButtonColor: "#28a745", // Green for "Done"
            cancelButtonColor: "#6c757d", // Red for cancel
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/api/user/order/orderDone/${orderId}`, {
                    method: "PATCH",
                }).then((response) => {
                    if (response.ok) {
                        Swal.fire({
                            icon: "success",
                            title: "Order marked as done and moved to history.",
                            confirmButtonColor: "#c01836",
                        });
                        removeOrder(orderId);
                    }
                });
            }
        });
    } else if (e.target.classList.contains("canceled")) {
        const orderId = e.target.getAttribute("orderId");
        // console.log("canceled")
        Swal.fire({
            title: "Sure you want to reject the order?",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "Yes, cancel order",
            cancelButtonText: "Cancel",
            color:"#cf2115c0",
            confirmButtonColor: "#d33", // Red for "Cancel"
            cancelButtonColor: "#6c757d", // Gray for cancel
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/api/user/order/orderCanceled/${orderId}`, {
                    method: "PATCH",
                }).then((response) => {
                    if (response.ok) {
                        Swal.fire({
                            icon: "success",
                            title: "Order canceled 😤,and moved to history",
                            confirmButtonColor: "#c01836",
                        });
                        removeOrder(orderId);
                    }
                });
            }
        });
    }else if (e.target.classList.contains("payed")) {
        const orderId = e.target.getAttribute("orderId");
        // console.log("canceled")
        Swal.fire({
            title: "Sure to change this order to payed ?",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "Yes, Mark as Payed",
            cancelButtonText: "Cancel",
            color:"#364a9a",
            confirmButtonColor: "#364a9a", // Red for "Cancel"
            cancelButtonColor: "#6c757d", // Gray for cancel
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/api/user/order/orderPayed/${orderId}`, {
                    method: "PATCH",
                }).then((response) => {
                    if (response.ok) {
                        Swal.fire({
                            icon: "success",
                            title: "Order Marked as Payed 💸💸",
                            confirmButtonColor: "#c01836",
                        });
                        window.location.reload();
                    }
                });
            }
        });
    }
});

        function printOrders() {
            window.print();
        }
    </script>
</body>
</html>
