<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <!----======== CSS ======== -->
    <link rel="stylesheet" href="/css/admin.css">

    <!----===== Iconscout CSS ===== -->
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <title>Edit Category — Carwan Dough Admin</title>
</head>
<body>
<%- include("Bases/adminBase") %>

            <div class="overview">
                <div class="title">
                    <i class="uil uil-edit"></i>
                    <div>
                        <span class="text">Edit Category</span>
                        <div class="page-sub">Update details for <%= cat.name %></div>
                    </div>
                </div>
            </div>
            <main>
                <div class="card form-card">
                    <div class="card-head">
                        <span class="card-title"><i class="uil uil-edit"></i>Category Details</span>
                        <a href="/content" class="btn btn-sm btn-ghost"><i class="uil uil-arrow-left"></i>Back to Content</a>
                    </div>
                    <div class="card-body">
                        <form action="/api/admin/content/edit-cetegory" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="category_id" value="<%= cat.id %>">
                            <div class="input-group">
                              <label for="product-name">Category name</label>
                              <input type="text" id="product-name" name="category_name" required value="<%= cat.name %>">
                            </div>
                            <div class="input-group">
                                <label>Current Image</label>
                                <div class="form-media-preview">
                                    <div class="media-box">
                                        <img src="/products/images/<%= cat.image %>" alt="<%= cat.name %>">
                                    </div>
                                </div>
                            </div>
                            <div class="input-group">
                              <label for="category-image">New Image</label>
                              <input type="file" id="category-image" name="category_image" value="">
                            </div>
                            <button type="submit" class="submit-button">Save Changes</button>
                          </form>
                    </div>
                </div>
            </main>
<%- include("Bases/adminBaseCloser") %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        //|-----------------------------------------------------------------|
        //|_________________________ send new data _________________________|
        //|-----------------------------------------------------------------|
        const catUpdateForm = document.querySelector("form")
        catUpdateForm.addEventListener("submit",(e)=>{
            e.preventDefault()
            const fd = new FormData(catUpdateForm)

            fetch("/api/admin/content/edit-category",{
                body:fd,
                method:"PUT"
            }).then(response => {
            if (response.ok) {
                Swal.fire({
                    icon: "success",
                    title: "category edited successfully",
                    "confirmButtonColor": "#c01836",
                });
                setTimeout(()=>{
                    window.location.href = "/content";
                },1000)
            } else {
                return response.text().then(errMsg => {
                    Swal.fire({
                    icon: "error",
                    title: "Error happened: " + errMsg,
                    "confirmButtonColor": "#c01836",
                    });
                });
            }
        })
        })

    </script>
</body>
</html>
