<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/products.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <title>Products</title>
    <style>
        .buy-custome{
            height: 2.7em;
            background-color:var(--white) ;
            color: var(--dark-red);
            font-weight: bold;
            border: none;
            border-radius: 5px;
            padding: 0 1em;
            font-size: 1em;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        .backArrow{
            padding-bottom: 5%;
            position: sticky;
            right: 95%;
            z-index: 999;
            top: 11px;
            align-self: center;
            background-color: var(--white);
            color: var(--dark-red);
            border: 2px var(--dark-red) solid;
            border-radius: 10px;
            cursor: pointer;
            width: 7vw;
            height: 4vw;
            font-size: 3vw;
            font-weight: 900;
        }
        @media (max-width: 768px) {
        .backArrow{
            right: 80%;
            padding-top: 2%;
            padding-bottom: 12%;
            top: 11px;
            width: 15vw;
            height: 0vw;
            font-size: 8vw;
            }
        }
    </style>
</head>
<body>
<%- include("Bases/CustomerHeader") %>
<button class="backArrow" onclick='window.location.href = "/home"'>&#127968;</button>

<% if(CWP){ %>
    <h1 class="head-lines menu"><%= CWP.name %></h1>
    <hr class="style-five">

    <main>
        <% for(let product of CWP.products) { %>
            <% if(product.isActive && !product.deleted){ %>
                <div class="product-card">
                    <a href="/product-info/<%= product.id %>" class="a">
                    <img src="/products/images/<%= product.photo %>" alt="">
                    <div class="product-info">
                        <h1 class="product-title"><%= product.name %></h1>
                        <% if(product.current_price !== product.price){ %>
                            <div class="price"><p>Price: <s style="color: var(--white);"><%= product.price %><span style="font-family: 'Courier New', Courier, monospace;">E£</span></p></div></s>
                            <div class="price"><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= product.current_price %><span style="font-family: 'Courier New', Courier, monospace;">E£</span></p></div>
                        <% }else{ %>
                            <div class="price"><p>Price: <%= product.current_price %><span style="font-family: 'Courier New', Courier, monospace;">E£</span></p></div>
                        <% } %>
                    </div>
                    </a>

                    <div id="counterWithBtns">
                        <% if(CWP.name !== "custom orders" && CWP.name !== "share boxs"){ %>
                        <span class="minus" product-id="<%= product.id %>" product-price="<%= product.current_price %>">-</span>
                        <span class="product-counter" id="product<%= product.id %>">0</span>
                        <span class="plus" product-id="<%= product.id %>" product-price="<%= product.current_price %>" >+</span>
                        <% }else{ %>
                            <a href="/product-info/<%= product.id %>" class="a"><button class="buy-custome">Order Now</button></a>
                        <% } %>
                    </div>

                </div>  
            <% } %>
        <% } %>
    </main>
<% } %>
    
    <a href="/cart" style="width: 100%;"><div class="cart-value">
        <div class="bar-item"><span class="counter" id="count_total">0</span></div>
    <svg class="bar-trolly bar-item" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" id="ast-cart-svg" x="0px" y="0px" width="15%" height="100%" viewBox="826 837.5 140 121" enable-background="new 826 837.5 140 121" xml:space="preserve">
