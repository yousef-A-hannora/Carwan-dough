    </svg>
    <p class="price cart-price bar-item" id="bar-price"> <span id="bar-price-value">0</span>&nbsp;EGP</p></div></a>

<%- include("Bases/CustomerFooter") %>
        
    <script>
        try{
            const OrderData = '<%= OWI %>'; // Safely embed Base64 string
            const order = JSON.parse(atob(OrderData)); // Decode and parse
            
            const OrderItems = order.orderItems
            // console.log(OrderItems)
            let totalCost =0
            let totalCount =0
            OrderItems.forEach((item)=>{
                // console.log(item)
                localStorage[`product${item.productId}`] = item.quantity
                totalCost+=item.price*item.quantity
                totalCount+=item.quantity
            })
            // console.log(totalCost)
            // console.log(totalCount)
            localStorage.price=totalCost
            localStorage.count=totalCount
        }catch(err){console.log(err);localStorage.clear()}
        const cartBarPrice = document.getElementById("bar-price-value");
        const cartBarQuantity = document.getElementById("count_total");

        // Initialize localStorage values if not already set
        if (!localStorage.price) localStorage.price = 0;
        if (!localStorage.count) localStorage.count = 0;
        
        cartBarPrice.innerText = Math.round(parseFloat(localStorage.price)* 10) / 10;
        cartBarQuantity.innerText = localStorage.count;

        document.addEventListener("DOMContentLoaded", () => {
            // Loop through all product counters and populate them from localStorage
            const productCounters = document.querySelectorAll(".product-counter");
            productCounters.forEach(counter => {
                const id = counter.id.replace("product", ""); // Extract product ID from the element ID
                const savedCount = localStorage[`product${id}`] || 0; // Default to 0 if no data
                counter.innerText = savedCount; // Update the counter display
            });
        })



function plus(id,price,elementCount){
    // console.log("plus btn clicked")
    let currentPrice = parseFloat(localStorage.price);
    let currentCount = parseInt(localStorage.count);

    localStorage.price = currentPrice + price;
    localStorage.count = currentCount + 1;

    // Update the UI
    cartBarPrice.innerText = Math.round(parseFloat(localStorage.price)* 10) / 10;
    cartBarQuantity.innerText = localStorage.count;

    if(!localStorage[`product${id}`]){localStorage[`product${id}`] = 0}
    let currentElementCount = parseFloat(localStorage[`product${id}`]);
    localStorage[`product${id}`] = currentElementCount + 1;

    elementCount.innerText = localStorage[`product${id}`]
}

function minus(id,price,elementCount){
    // Convert to numbers before adding
    let currentPrice = parseFloat(localStorage.price);
    let currentCount = parseInt(localStorage.count);

    if(localStorage.price > 0 && localStorage.count > 0 && localStorage[`product${id}`]>0) {
        localStorage.price = currentPrice - price;
        localStorage.count = currentCount - 1;
    }
    // Update the UI
    cartBarPrice.innerText = Math.round(parseFloat(localStorage.price)* 10) / 10;
    cartBarQuantity.innerText = localStorage.count;

    if(!localStorage[`product${id}`]){localStorage[`product${id}`] = 0}
    let currentElementCount = parseFloat(localStorage[`product${id}`]);
    if(currentElementCount > 0) {
        localStorage[`product${id}`] = currentElementCount - 1;
    }
    elementCount.innerText = localStorage[`product${id}`]
}

document.addEventListener("click", (e) => {
    // console.log("reached click event")
    if (e.target.classList.contains("plus")) {
    let id = parseInt(e.target.getAttribute("product-id"));
    let price = parseFloat(e.target.getAttribute("product-price"));
    let elementCount = document.getElementById(`product${id}`)
    // Convert to numbers before adding
    // plus(id,price,elementCount);

    fetch(`/api/user/order/addToCart/${id}`,{
        method: 'PATCH',
    }).then(responce=>{
        if(responce.ok){
            plus(id,price,elementCount);
        }else{
            console.log("Error happned")
        }
    })
}

            if (e.target.classList.contains("minus")) {
                let id = parseInt(e.target.getAttribute("product-id"));
                let price = parseFloat(e.target.getAttribute("product-price"));
                let elementCount = document.getElementById(`product${id}`)
                fetch(`/api/user/order/removeFromCart/${id}`,{
                    method: 'PATCH',
                    }).then(responce=>{
                            if(responce.ok){
                                minus(id,price,elementCount);
                            }else{
                                console.log("Error happned")
                            }
                        })
            }
        });
    </script>

<script src="/JS/products.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const logoutLink = document.getElementById("logout-link");

        if (logoutLink) {
            logoutLink.addEventListener("click", (event) => {
                event.preventDefault(); // Prevent the default navigation

                Swal.fire({
                    title: 'really want to logout',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: 'green',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, logout!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = logoutLink.href; // Redirect if confirmed
                    }
                });
            });
        }
    });
</script>
</body>
</html>

