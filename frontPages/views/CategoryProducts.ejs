<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("Bases/CustomerHead", {title: CWP ? CWP.name : "Menu"}) %>
    <link rel="stylesheet" href="/css/shop-menu.css">
</head>
<body>
<%- include("Bases/CustomerHeader") %>

<main class="menu-page">
<% if(CWP){ %>
    <nav class="cd-container cd-breadcrumb" aria-label="Breadcrumb">
        <a href="/home">Home</a>
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        <span aria-current="page"><%= CWP.name %></span>
    </nav>

    <div class="cd-container">
        <h1 class="menu-page__title"><%= CWP.name %></h1>

        <% const activeProducts = CWP.products.filter(p => p.isActive && !p.deleted); %>
        <% if(activeProducts.length === 0){ %>
            <div class="cd-empty cd-card">
                <i class="fa-solid fa-cookie" aria-hidden="true"></i>
                <h2>Nothing here yet</h2>
                <p>This category is out of treats right now — check back soon or browse the rest of the menu.</p>
                <a href="/home#menu" class="cd-btn">Browse the menu</a>
            </div>
        <% }else{ %>
        <div class="products-grid">
            <% let cardIndex = 0; %>
            <% for(let product of activeProducts) { %>
                <article class="product-card cd-card cd-reveal" style="--i:<%= cardIndex % 4 + 1 %>;">
                    <a href="/product-info/<%= product.id %>" class="product-card__link">
                        <img src="/products/images/<%= product.photo %>" alt="<%= product.name %>" class="product-card__img" loading="lazy" width="400" height="400">
                        <div class="product-card__body">
                            <h2 class="product-card__title"><%= product.name %></h2>
                            <div class="product-card__prices">
                                <% if(product.current_price !== product.price){ %>
                                    <s><%= product.price %> EGP</s>
                                    <span><%= product.current_price %> EGP</span>
                                    <span class="cd-badge-sale">Sale</span>
                                <% }else{ %>
                                    <span><%= product.current_price %> EGP</span>
                                <% } %>
                            </div>
                        </div>
                    </a>

                    <div id="counterWithBtns" class="product-card__stepper">
                        <% if(CWP.name !== "custom orders" && CWP.name !== "share boxs"){ %>
                        <button type="button" class="minus cd-stepper__btn" product-id="<%= product.id %>" product-price="<%= product.current_price %>" aria-label="Remove one <%= product.name %>">−</button>
                        <span class="product-counter" id="product<%= product.id %>" aria-live="polite">0</span>
                        <button type="button" class="plus cd-stepper__btn" product-id="<%= product.id %>" product-price="<%= product.current_price %>" aria-label="Add one <%= product.name %>">+</button>
                        <% }else{ %>
                            <a href="/product-info/<%= product.id %>" class="cd-btn cd-btn-sm" style="width:100%;"><%= CWP.name === "share boxs" ? "Build your box" : "Order now" %></a>
                        <% } %>
                    </div>
                </article>
                <% cardIndex++; %>
            <% } %>
        </div>
        <% } %>
    </div>
<% }else{ %>
    <div class="cd-container">
        <div class="cd-empty cd-card" style="margin-top: var(--cd-s8);">
            <i class="fa-solid fa-cookie" aria-hidden="true"></i>
            <h2>Category not found</h2>
            <p>We couldn't find this category — head back to the full menu.</p>
            <a href="/home#menu" class="cd-btn">Browse the menu</a>
        </div>
    </div>
<% } %>
</main>

<a href="/cart" class="cart-bar" aria-label="View cart">
    <span class="cart-bar__count"><i class="fa-solid fa-basket-shopping" aria-hidden="true"></i><span class="counter" id="count_total">0</span></span>
    <span class="cart-bar__label">View cart</span>
    <span class="cart-bar__total"><span id="bar-price-value">0</span> EGP</span>
</a>

<%- include("Bases/CustomerFooter") %>

    <script>
        try{
            const OrderData = '<%= OWI %>'; // Safely embed Base64 string
            const order = JSON.parse(atob(OrderData)); // Decode and parse

            const OrderItems = order.orderItems
            // console.log(OrderItems)
            let totalCost =0
            let totalCount =0
            OrderItems.forEach((item)=>{
                // console.log(item)
                localStorage[`product${item.productId}`] = item.quantity
                totalCost+=item.price*item.quantity
                totalCount+=item.quantity
            })
            // console.log(totalCost)
            // console.log(totalCount)
            localStorage.price=totalCost
            localStorage.count=totalCount
        }catch(err){console.log(err);localStorage.clear()}
        const cartBarPrice = document.getElementById("bar-price-value");
        const cartBarQuantity = document.getElementById("count_total");

        // Initialize localStorage values if not already set
        if (!localStorage.price) localStorage.price = 0;
        if (!localStorage.count) localStorage.count = 0;

        cartBarPrice.innerText = Math.round(parseFloat(localStorage.price)* 10) / 10;
        cartBarQuantity.innerText = localStorage.count;

        document.addEventListener("DOMContentLoaded", () => {
            // Loop through all product counters and populate them from localStorage
            const productCounters = document.querySelectorAll(".product-counter");
            productCounters.forEach(counter => {
                const id = counter.id.replace("product", ""); // Extract product ID from the element ID
                const savedCount = localStorage[`product${id}`] || 0; // Default to 0 if no data
                counter.innerText = savedCount; // Update the counter display
            });
        })



function plus(id,price,elementCount){
    // console.log("plus btn clicked")
    let currentPrice = parseFloat(localStorage.price);
    let currentCount = parseInt(localStorage.count);

    localStorage.price = currentPrice + price;
    localStorage.count = currentCount + 1;

    // Update the UI
    cartBarPrice.innerText = Math.round(parseFloat(localStorage.price)* 10) / 10;
    cartBarQuantity.innerText = localStorage.count;

    if(!localStorage[`product${id}`]){localStorage[`product${id}`] = 0}
    let currentElementCount = parseFloat(localStorage[`product${id}`]);
    localStorage[`product${id}`] = currentElementCount + 1;

    elementCount.innerText = localStorage[`product${id}`]
}

function minus(id,price,elementCount){
    // Convert to numbers before adding
    let currentPrice = parseFloat(localStorage.price);
    let currentCount = parseInt(localStorage.count);

    if(localStorage.price > 0 && localStorage.count > 0 && localStorage[`product${id}`]>0) {
        localStorage.price = currentPrice - price;
        localStorage.count = currentCount - 1;
    }
    // Update the UI
    cartBarPrice.innerText = Math.round(parseFloat(localStorage.price)* 10) / 10;
    cartBarQuantity.innerText = localStorage.count;

    if(!localStorage[`product${id}`]){localStorage[`product${id}`] = 0}
    let currentElementCount = parseFloat(localStorage[`product${id}`]);
    if(currentElementCount > 0) {
        localStorage[`product${id}`] = currentElementCount - 1;
    }
    elementCount.innerText = localStorage[`product${id}`]
}

document.addEventListener("click", (e) => {
    // console.log("reached click event")
    if (e.target.classList.contains("plus")) {
    let id = parseInt(e.target.getAttribute("product-id"));
    let price = parseFloat(e.target.getAttribute("product-price"));
    let elementCount = document.getElementById(`product${id}`)
    // Convert to numbers before adding
    // plus(id,price,elementCount);

    fetch(`/api/user/order/addToCart/${id}`,{
        method: 'PATCH',
    }).then(responce=>{
        if(responce.ok){
            plus(id,price,elementCount);
        }else{
            console.log("Error happned")
        }
    })
}

            if (e.target.classList.contains("minus")) {
                let id = parseInt(e.target.getAttribute("product-id"));
                let price = parseFloat(e.target.getAttribute("product-price"));
                let elementCount = document.getElementById(`product${id}`)
                fetch(`/api/user/order/removeFromCart/${id}`,{
                    method: 'PATCH',
                    }).then(responce=>{
                            if(responce.ok){
                                minus(id,price,elementCount);
                            }else{
                                console.log("Error happned")
                            }
                        })
            }
        });
    </script>

<script src="/JS/products.js"></script>

</body>
</html>
