<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout Page</title>
    <link rel="stylesheet" href="css/cart.css">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

    <style>
        .qty-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .qty-btn {
            padding: 5px 10px;
            border: none;
            background-color: #c01836;
            color: white;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        .delete {
            background-color: var(--red);
            color: white;
            padding: 0.5em;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            font-size: 0.6em;
        }
    </style>
</head>

<body>

    <div class="logo-container">
        <a href="/home"><img src="imgs/logo.PNG" class="logo"></a>
    </div>

    <div class="checkout-container">
        <h2 class="cart-title">Your Cart</h2>

        <% if (OWI && OWI.orderItems.length> 0) { %>

            <!-- CART TABLE -->
            <table class="checkout-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody id="cart-items">
                    <% for (let item of OWI.orderItems) { %>
                        <tr>
                            <td>
                                <%= item.product.name %>
                            </td>
                            <td>
                                <%= item.product.current_price %>
                            </td>

                            <td>
                                <div class="qty-controls">
                                    <button class="qty-btn minus" data-id="<%= item.product.id %>">-</button>

                                    <span class="quantity" id="qty-<%= item.product.id %>">
                                        <%= item.quantity %>
                                    </span>

                                    <button class="qty-btn plus" data-id="<%= item.product.id %>">+</button>
                                </div>
                            </td>

                            <td>
                                <button class="delete" product-id="<%= item.product.id %>">remove</button>
                            </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>

            <div class="total-section">
                <span class="payment-amount" style="color: #8b021b;">
                    Total:
                    <span id="total-price">
                        <%= OWI.totalPrice %>
                    </span>
                </span>
            </div>

            <!-- CHECKOUT FORM -->
            <form id="payment-form" method="post">
                <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                    <h3>Name:</h3>
                    <textarea class="address-style" name="name" rows="1"><%= user.name %></textarea>
                </div>

                <!-- Phone fields -->
                <div id="phone-container">
                    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                        <h3>Phone:</h3>
                        <textarea class="address-style" name="phone[]" rows="1" placeholder="Enter phone"
                            required></textarea>
                    </div>
                </div>

                <button type="button" id="add-phone-btn"
                    style="background-color: var(--red); color: white; padding: 0.5em; border: none; cursor: pointer;border-radius: 5px; margin-top:10px;">
                    Add Phone
                </button>

                <h3>Address:</h3>
                <textarea class="address-style" name="address" rows="3" required><%= user.address %></textarea>

                <h3>Notes:</h3>
                <textarea class="address-style" name="notes" rows="3"></textarea>

                <!-- Delivery Date -->
                <h3>Date of receipt (تاريخ الاستلام)</h3>
                <input type="date" name="date" id="DOR" required>

                <h3 style="margin-top: 1em;">Select Payment Method</h3>
                <label>
                    <input type="radio" name="paymentMethod" value="cash-on-delivery" checked>
                    Pay on Delivery (دفع عند الاستلام)
                </label>

                <div style="width: 100%; display: flex; justify-content: center; margin-top: 1em;">
                    <button type="submit" class="checkout-btn" id="placeorder-btn">Place Order</button>
                </div>
            </form>

            <% } else { %>
                <h3 style="text-align:center;">You need to buy something!</h3>
                <% } %>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- ADD PHONE FIELDS -->
<script>
    document.getElementById("add-phone-btn").addEventListener("click", () => {
        const container = document.getElementById("phone-container");
        const field = document.createElement("div");

        field.style.cssText = "display:flex;justify-content:space-between;align-items:flex-end;margin-top:1em";

        field.innerHTML = `
            <h3>Phone:</h3>
            <textarea class="address-style phone-field" name="phone[]" rows="1" placeholder="Enter phone"></textarea>
            <button type="button" class="remove-phone-btn" 
                style="background:#f44336;color:white;padding:0.5em;border:none;border-radius:5px;margin-left:10px;">
                Remove
            </button>
        `;

        container.appendChild(field);

        field.querySelector(".remove-phone-btn").onclick = () => field.remove();
    });
</script>

<!-- DATE: PREVENT PAST -->
<script>
    const dateInput = document.getElementById("DOR");
    const today = new Date().toISOString().split("T")[0];
    dateInput.min = today;
</script>

<!-- WORKDAY VALIDATION -->
<script>
    const workdays = JSON.parse('<%- workingDays %>');
    const dateField = document.getElementById("DOR");

    function getWeekdayName(date) {
        return ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'][date.getDay()];
    }

    function getNextWorkday(startDate) {
        let d = new Date(startDate);
        while (!workdays.includes(getWeekdayName(d).toLowerCase())) {
            d.setDate(d.getDate() + 1);
        }
        return d;
    }

    dateField.addEventListener("change", () => {
        const selected = new Date(dateField.value);
        const dayName = getWeekdayName(selected).toLowerCase();

        if (!workdays.includes(dayName)) {
            const next = getNextWorkday(selected);
            const y = next.getFullYear();
            const m = String(next.getMonth() + 1).padStart(2, '0');
            const d = String(next.getDate()).padStart(2, '0');

            Swal.fire({
                icon: "info",
                title: "Warning",
                text: `اليوم ده مش يوم شغل. اقرب يوم هو ${d}-${m}-${y}`,
                confirmButtonColor: "#c01836"
            });

            dateField.value = `${y}-${m}-${d}`;
        }
    });
</script>

<!-- FULL VALIDATION + SUBMIT -->
<script>
    const checkoutForm = document.getElementById("payment-form");

    checkoutForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        let valid = true;

        const phones = document.querySelectorAll("textarea[name='phone[]']");
        const address = document.querySelector("textarea[name='address']");
        const date = document.getElementById("DOR");

        const phoneRegex = /^01\d{9}$/;

        // ---- PHONE VALIDATION (loop all phones) ----
        phones.forEach(phone => {
            const value = phone.value.trim();

            if (!phoneRegex.test(value)) {
                phone.classList.add("is-invalid");
                valid = false;
            } else {
                phone.classList.remove("is-invalid");
            }
        });

        // ---- ADDRESS VALIDATION ----
        if (!address || address.value.trim().length < 5) {
            address.classList.add("is-invalid");
            valid = false;
        } else {
            address.classList.remove("is-invalid");
        }

        // ---- DATE VALIDATION ----
        const selectedDate = new Date(date.value);
        const today = new Date();
        today.setHours(0,0,0,0);

        if (selectedDate < today) {
            date.classList.add("is-invalid");
            valid = false;
        } else {
            date.classList.remove("is-invalid");
        }

        // STOP SUBMIT IF INVALID
        if (!valid) {
            return Swal.fire({
                icon: "error",
                title: "enter valid phone number",
                confirmButtonColor: "#c01836",
            });
        }

        // ----- SEND ORDER -----
        const fd = new FormData(checkoutForm);
        const encoded = new URLSearchParams(fd).toString();

        const res = await fetch("/api/user/order/checkout", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: encoded
        });

        if (res.ok) {
            Swal.fire({
                icon: "success",
                title: "Thanks for Using Carwan Dough 😊",
                confirmButtonColor: "#c01836",
            });

            setTimeout(() => {
                window.location.href = "/home";
            }, 1500);
        }
    });
</script>

<!-- QUANTITY BUTTONS -->
<script>
    document.addEventListener("click", async (e) => {

        // ADD ( + )
        if (e.target.classList.contains("plus")) {
            const id = e.target.dataset.id;
            await fetch(`/api/user/order/addToCart/${id}`, { method: "PATCH" });
            location.reload();
        }

        // REMOVE ONE ( - )
        if (e.target.classList.contains("minus")) {
            const id = e.target.dataset.id;
            await fetch(`/api/user/order/removeFromCart/${id}`, { method: "PATCH" });
            location.reload();
        }



        if (e.target.classList.contains("delete")) {
            let id = parseInt(e.target.getAttribute("product-id"));

            fetch(`/api/user/order/deleteItem/${id}`,{
                method: 'PATCH',
            }).then(responce=>{
                if(responce.ok){
                    Swal.fire({
                        icon: "success",
                        title: "Item deleted successfully",
                        "confirmButtonColor": "#c01836",
                    });
                    setTimeout(()=>{
                        window.location.href = "/cart";                   
                    },500)

                }else{
                    console.log("Error happned")
                }
            })
        }

    });
</script>

</body>

</html>