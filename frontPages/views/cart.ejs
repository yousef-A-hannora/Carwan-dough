<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout Page</title>
    <link rel="stylesheet" href="css/cart.css">
    <link rel="shortcut icon" href="imgs/mini-logo.png" type="image/x-icon">

</head>
<body>
    <div class="logo-container">
        <a href="/home"><img src="imgs/logo.PNG" class="logo"></a>
    </div>
    <div class="checkout-container">
        <h2 class="cart-title">Your Cart</h2>

        <% if(OWI && OWI.orderItems.length > 0) { %>
        <table class="checkout-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="cart-items">

                <% for(let item of OWI.orderItems) {%>
                <tr>
                    <td><%= item.product.name %></td>
                    <td><%= item.product.current_price %></td>
                    <td>
                        <span class="quantity"><%= item.quantity %></span>
                    </td>
                    <td>
                        <div style="width: 100%;;display: flex;align-items: center;justify-content: center;">
                            <button class="delete" style="background-color: var(--red); color: white; padding: 0.5em; border: none; cursor: pointer;border-radius: 5px;font-size: 0.6em;" product-id="<%= item.product.id %>">remove</button>
                        </div>
                    </td>
                </tr>
                <% } %>

            </tbody>
        </table>
        
        <div class="total-section">
            <span class="payment-amount" style="color: #8b021b;">Total: <span id="total-price" class="payment-amount"><%= OWI.totalPrice %></span></span>
        </div>
        <form id="payment-form" action="#" method="post">
            <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                <h3>Name: </h3>
                <textarea class="address-style" name="name" cols="30" rows="1"><%= user.name %></textarea>
            </div>
        
            <div id="phone-container">
                <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                    <h3>Phone: </h3>
                    <textarea class="address-style" name="phone[]" cols="30" rows="1" placeholder="Enter phone number" required></textarea>
                </div>
            </div>
        
            <div style="display: flex; justify-content: flex-start; margin-top: 1em;">
                <button type="button" id="add-phone-btn" style="background-color: var(--red); color: white; padding: 0.5em; border: none; cursor: pointer;border-radius: 5px;">Add Phone</button>
            </div>
        
            <h3>Address: </h3>*click to change*
            <textarea class="address-style" name="address" rows="3"><%= user.address %></textarea>
        
            <h3>Notes: </h3>*click to change*
            <textarea class="address-style" name="notes" rows="3"></textarea>

            <h3>Date of receipt(تاريخ الاستلام)</h3>
            <input type="date" name="date" required id="DOR">
        
            <h3 style="margin-bottom: 1em;">Select Payment Method</h3>
            <label style="display: block;">
                <input type="radio" name="paymentMethod" value="cash-on-delivery" checked>
                Pay on Delivery(دفع عند الاستلام)
            </label>
            <!-- <br>
            <label>
                <input type="radio" name="paymentMethod" value="credit-card" id="checkout-btn">
                Pay with Credit Card
            </label> -->
        
            <div style="width: 100%; display: flex; justify-content: center; margin-top: 1em;">
                <button type="submit" class="checkout-btn" id="placeorder-btn">Place Order</button>
            </div>
        </form>
        
        <!-- <button type="submit" class="checkout-btn" id="placeorder-btn">Place Order</button> -->

        <% }else{ %>
            <h3 style="text-align: center;">You need to buy something!!</h3>
        <% } %>

    </div>

    <!-- Popup Modal -->
    <!-- <div id="payment-modal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>
                    
            <div id="credit-card-info" class="hidden">
                <iframe src="https://accept.paymob.com/7d7d57e0-a56c-46d4-a2db-17c00a134ee3" frameborder="0"></iframe>
            </div>
        </div>
    </div> -->

<!-- <script src="JS/cart.js"></script> -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
    const phoneContainer = document.getElementById("phone-container");
    const addPhoneBtn = document.getElementById("add-phone-btn");

    addPhoneBtn.addEventListener("click", () => {
        // Create a new phone number field
        const phoneField = document.createElement("div");
        phoneField.style.display = "flex";
        phoneField.style.justifyContent = "space-between";
        phoneField.style.alignItems = "flex-end";
        phoneField.style.marginTop = "1em";

        phoneField.innerHTML = `
            <h3>Phone: </h3>
            <textarea class="address-style" name="phone[]" cols="30" rows="1" placeholder="Enter additional phone number"></textarea>
            <button type="button" class="remove-phone-btn" style="background-color: #f44336; color: white; padding: 0.5em; border: none; cursor: pointer; margin-left: 1em;border-radius: 5px;">Remove</button>
        `;

        phoneContainer.appendChild(phoneField);

        // Add event listener for the remove button
        phoneField.querySelector(".remove-phone-btn").addEventListener("click", () => {
            phoneField.remove();
        });
    });
});

</script>
<script>

const workdays = JSON.parse('<%- workingDays %>'); // e.g., ['saturday', 'tuesday', ...]
const dateField = document.getElementById("DOR");

// Function to get the weekday name for a given Date object
function getWeekdayName(date) {
    const weekdays = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
    return weekdays[date.getDay()]; // Returns the name of the day
}

// Function to find the next available workday
function getNextWorkday(startDate) {
    let nextDate = new Date(startDate); // Start with the provided date
    while (!workdays.includes(getWeekdayName(nextDate).toLowerCase())) {
        nextDate.setDate(nextDate.getDate() + 1); // Move to the next day
    }
    return nextDate;
}

// Add an event listener for when the user selects a date
dateField.addEventListener("change", () => {
    const selectedDate = new Date(dateField.value);
    const selectedDayName = getWeekdayName(selectedDate).toLowerCase();

    if (!workdays.includes(selectedDayName)) {
        const nextWorkday = getNextWorkday(selectedDate);
        const year = nextWorkday.getFullYear();
        const month = String(nextWorkday.getMonth() + 1).padStart(2, '0'); // Months are 0-based
        const day = String(nextWorkday.getDate()).padStart(2, '0');

        // Alert the user and update the input value
        const delaiedDay = `${day} ${new Date().toLocaleString('default', { month: 'long' })}`
        Swal.fire({
            icon: "info",
            title: "Worning",
            "text":` للاسف اليوم دا مش يوم شغل بالنسبالنا و اقرب يوم تقدر تستلم فيه الاوردر هو يوم${delaiedDay}`,
            "confirmButtonColor": "#c01836",
        });
        dateField.value = `${year}-${month}-${day}`;
    }
});

const checkoutForm = document.querySelector("form")
// const placeOrderBtn = document.getElementById("placeorder-btn")
// placeOrderBtn.addEventListener("click", (e) => {checkoutForm.submit()})

checkoutForm.addEventListener("submit", (e) => {
    // console.log("form submitted")
    let addQuantity = document.getElementById("add-quantity");

    e.preventDefault();
    const fd = new FormData(checkoutForm);
    const UrlEncodedData = new URLSearchParams(fd).toString();

    fetch("/api/user/order/checkout",{
        body:UrlEncodedData,
        method:"POST",
        headers:{
            "Content-Type": "application/x-www-form-urlencoded",
        }
    }).then(responce=>{
        if(responce.ok){
            Swal.fire({
                icon: "success",
                title: "Thanks for Using Carwan Dough😊",
                "confirmButtonColor": "#c01836",
            });

            setTimeout(()=>{
                window.location.href = "/home";                   
            },1500)
        }
    })
})
</script>

<script>
    document.addEventListener("click", (e) => {
    console.log("reached click event")
        if (e.target.classList.contains("delete")) {
            let id = parseInt(e.target.getAttribute("product-id"));

            fetch(`/api/user/order/deleteItem/${id}`,{
                method: 'PATCH',
            }).then(responce=>{
                if(responce.ok){
                    Swal.fire({
                        icon: "success",
                        title: "Item deleted successfully",
                        "confirmButtonColor": "#c01836",
                    });
                    setTimeout(()=>{
                        window.location.href = "/cart";                   
                    },500)

                }else{
                    console.log("Error happned")
                }
            })
        }
    });
</script>
</body>
</html>
