<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("Bases/CustomerHead", {title: "Your cart"}) %>
    <link rel="stylesheet" href="/css/shop-cart.css">
</head>
<body>
    <%- include("Bases/CustomerHeader") %>

    <nav class="cd-container cd-breadcrumb" aria-label="Breadcrumb">
        <a href="/home">Home</a>
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        <span aria-current="page">Cart</span>
    </nav>

    <main class="cd-container cart-page">
        <h1 class="cart-page__title">Your Cart</h1>

        <% if(OWI && OWI.orderItems.length > 0) { %>
        <div class="cart-layout">
            <section class="cart-items" aria-label="Cart items">
                <% for(let item of OWI.orderItems) {%>
                <div class="cart-item cd-card">
                    <div>
                        <h2 class="cart-item__name"><%= item.product.name %></h2>
                        <p class="cart-item__meta"><%= item.product.current_price %> EGP &times; <span class="quantity"><%= item.quantity %></span></p>
                    </div>
                    <div>
                        <p class="cart-item__line"><%= item.product.current_price * item.quantity %> EGP</p>
                        <button type="button" class="delete" product-id="<%= item.product.id %>" aria-label="Remove <%= item.product.name %>">
                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>Remove
                        </button>
                    </div>
                </div>
                <% } %>
            </section>

            <aside class="checkout-card cd-card" aria-label="Checkout">
                <h2>Order summary</h2>
                <div class="checkout-total">
                    <span>Total</span>
                    <span><span id="total-price" class="payment-amount"><%= OWI.totalPrice %></span> EGP</span>
                </div>

                <form id="payment-form" action="#" method="post">
                    <label class="cd-field" for="customer-name">
                        <span>Name</span>
                        <input type="text" id="customer-name" class="cd-input" name="name" value="<%= user.name %>">
                    </label>

                    <div id="phone-container">
                        <div class="cd-phone-row">
                            <label class="cd-field" for="customer-phone" style="flex:1;">
                                <span>Phone</span>
                                <input type="tel" id="customer-phone" class="cd-input" name="phone[]" placeholder="Enter phone number" required>
                            </label>
                        </div>
                    </div>
                    <button type="button" id="add-phone-btn" class="cd-btn-secondary cd-btn-sm" style="margin-bottom: var(--cd-s4);">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>Add another phone
                    </button>

                    <label class="cd-field" for="customer-address">
                        <span>Address</span>
                        <textarea id="customer-address" class="cd-input" name="address" rows="3"><%= user.address %></textarea>
                        <span class="cd-hint">Tap to edit your delivery address.</span>
                    </label>

                    <label class="cd-field" for="customer-notes">
                        <span>Notes</span>
                        <textarea id="customer-notes" class="cd-input" name="notes" rows="3" placeholder="Anything we should know?"></textarea>
                        <span class="cd-hint">Optional — e.g. occasion, gate code, preferred time.</span>
                    </label>

                    <label class="cd-field" for="DOR">
                        <span>Delivery date · تاريخ الاستلام</span>
                        <input type="date" name="date" required id="DOR" class="cd-input">
                    </label>

                    <div class="cd-field" role="group" aria-label="Payment method">
                        <span style="display:block;margin-bottom:var(--cd-s1);font-family:var(--cd-font-head);font-weight:600;">Payment method</span>
                        <div class="pay-methods">
                            <label class="pay-card">
                                <input type="radio" name="paymentMethod" value="cash-on-delivery" checked>
                                <span>
                                    <span class="pay-card__label">Pay on delivery · دفع عند الاستلام</span>
                                    <span class="pay-card__hint">Cash when your order arrives.</span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="cd-btn" id="placeorder-btn">
                        <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>Place order
                    </button>
                </form>
            </aside>
        </div>

        <% }else{ %>
            <div class="cd-empty cd-card">
                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                <h2>Your cart is empty</h2>
                <p>Looks like you haven't picked any treats yet — the menu is full of them.</p>
                <a href="/home#menu" class="cd-btn">Browse the menu</a>
            </div>
        <% } %>
    </main>

    <%- include("Bases/CustomerFooter") %>

<script>
    document.addEventListener("DOMContentLoaded", () => {
    const phoneContainer = document.getElementById("phone-container");
    const addPhoneBtn = document.getElementById("add-phone-btn");

    if (phoneContainer && addPhoneBtn) {
    addPhoneBtn.addEventListener("click", () => {
        // Create a new phone number field
        const phoneField = document.createElement("div");
        phoneField.className = "cd-phone-row";

        phoneField.innerHTML = `
            <label class="cd-field" style="flex:1;">
                <span>Phone</span>
                <input type="tel" class="cd-input" name="phone[]" placeholder="Enter additional phone number">
            </label>
            <button type="button" class="remove-phone-btn">Remove</button>
        `;

        phoneContainer.appendChild(phoneField);

        // Add event listener for the remove button
        phoneField.querySelector(".remove-phone-btn").addEventListener("click", () => {
            phoneField.remove();
        });
    });
    }
});

</script>
<script>

const workdays = JSON.parse('<%- workingDays %>'); // e.g., ['saturday', 'tuesday', ...]
const dateField = document.getElementById("DOR");

// Function to get the weekday name for a given Date object
function getWeekdayName(date) {
    const weekdays = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
    return weekdays[date.getDay()]; // Returns the name of the day
}

// Function to find the next available workday
function getNextWorkday(startDate) {
    let nextDate = new Date(startDate); // Start with the provided date
    while (!workdays.includes(getWeekdayName(nextDate).toLowerCase())) {
        nextDate.setDate(nextDate.getDate() + 1); // Move to the next day
    }
    return nextDate;
}

if (dateField) {
// Add an event listener for when the user selects a date
dateField.addEventListener("change", () => {
    const selectedDate = new Date(dateField.value);
    const selectedDayName = getWeekdayName(selectedDate).toLowerCase();

    if (!workdays.includes(selectedDayName)) {
        const nextWorkday = getNextWorkday(selectedDate);
        const year = nextWorkday.getFullYear();
        const month = String(nextWorkday.getMonth() + 1).padStart(2, '0'); // Months are 0-based
        const day = String(nextWorkday.getDate()).padStart(2, '0');

        // Alert the user and update the input value
        const delaiedDay = `${day} ${new Date().toLocaleString('default', { month: 'long' })}`
        Swal.fire({
            icon: "info",
            title: "Worning",
            "text":` للاسف اليوم دا مش يوم شغل بالنسبالنا و اقرب يوم تقدر تستلم فيه الاوردر هو يوم${delaiedDay}`,
            "confirmButtonColor": "#c01836",
        });
        dateField.value = `${year}-${month}-${day}`;
    }
});
}

const checkoutForm = document.querySelector("form")
// const placeOrderBtn = document.getElementById("placeorder-btn")
// placeOrderBtn.addEventListener("click", (e) => {checkoutForm.submit()})

if (checkoutForm) {
checkoutForm.addEventListener("submit", (e) => {
    // console.log("form submitted")
    let addQuantity = document.getElementById("add-quantity");

    e.preventDefault();
    const fd = new FormData(checkoutForm);
    const UrlEncodedData = new URLSearchParams(fd).toString();

    fetch("/api/user/order/checkout",{
        body:UrlEncodedData,
        method:"POST",
        headers:{
            "Content-Type": "application/x-www-form-urlencoded",
        }
    }).then(responce=>{
        if(responce.ok){
            Swal.fire({
                icon: "success",
                title: "Thanks for Using Carwan Dough😊",
                "confirmButtonColor": "#c01836",
            });

            setTimeout(()=>{
                window.location.href = "/home";
            },1500)
        }
    })
})
}
</script>

<script>
    document.addEventListener("click", (e) => {
    console.log("reached click event")
        if (e.target.classList.contains("delete")) {
            let id = parseInt(e.target.getAttribute("product-id"));

            fetch(`/api/user/order/deleteItem/${id}`,{
                method: 'PATCH',
            }).then(responce=>{
                if(responce.ok){
                    Swal.fire({
                        icon: "success",
                        title: "Item deleted successfully",
                        "confirmButtonColor": "#c01836",
                    });
                    setTimeout(()=>{
                        window.location.href = "/cart";
                    },500)

                }else{
                    console.log("Error happned")
                }
            })
        }
    });
</script>
</body>
</html>
